<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder.AppleTV.Storyboard" version="3.0" toolsVersion="24000" targetRuntime="AppleTV" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="Lau-nc-hVC">
    <device id="appleTV" appearance="dark"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24000"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Launch Screen-->
        <scene sceneID="Lau-nc-hSC">
            <objects>
                <viewController id="Lau-nc-hVC" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Lau-nc-hVW">
                        <rect key="frame" x="0.0" y="0.0" width="1920" height="1080"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="center" image="TVLaunchMark" translatesAutoresizingMaskIntoConstraints="NO" id="Lau-nc-hMK" userLabel="Mark">
                                <rect key="frame" x="640" y="380" width="640" height="320"/>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="Lau-nc-hSA"/>
                        <color key="backgroundColor" name="TVLaunchBackground"/>
                        <constraints>
                            <constraint firstItem="Lau-nc-hMK" firstAttribute="centerX" secondItem="Lau-nc-hVW" secondAttribute="centerX" id="Lau-nc-hCX"/>
                            <constraint firstItem="Lau-nc-hMK" firstAttribute="centerY" secondItem="Lau-nc-hVW" secondAttribute="centerY" id="Lau-nc-hCY"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="Lau-nc-hFR" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="TVLaunchMark" width="640" height="320"/>
        <namedColor name="TVLaunchBackground">
            <color red="0.055" green="0.055" blue="0.055" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
