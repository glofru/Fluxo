    "NSLocalNetworkUsageDescription" : {
      "comment" : "Permission prompt: why the app asks for Local Network access (Info.plist NSLocalNetworkUsageDescription).",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Fluxo الشبكة المحلية للعثور على Chromecast وأجهزة Google Cast الأخرى، لتتمكن من مشاهدة القنوات على التلفزيون."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo verwendet das lokale Netzwerk, um Chromecast und andere Google-Cast-Geräte zu finden, damit du Sender auf deinem Fernseher ansehen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fluxo uses the local network to find Chromecast and other Google Cast devices, so you can watch channels on your TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo usa la red local para encontrar dispositivos Chromecast y otros dispositivos Google Cast, para que puedas ver canales en tu TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo utilise le réseau local pour trouver les appareils Chromecast et autres appareils Google Cast, afin que vous puissiez regarder des chaînes sur votre téléviseur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo, Chromecast और अन्य Google Cast डिवाइस ढूँढने के लिए लोकल नेटवर्क का उपयोग करता है, ताकि आप अपने TV पर चैनल देख सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo menggunakan jaringan lokal untuk menemukan Chromecast dan perangkat Google Cast lainnya, sehingga Anda dapat menonton saluran di TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo usa la rete locale per trovare Chromecast e altri dispositivi Google Cast, così puoi guardare i canali sulla TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxoはローカルネットワークを使用してChromecastやその他のGoogle Castデバイスを探し、テレビでチャンネルを視聴できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV에서 채널을 시청할 수 있도록 Fluxo가 로컬 네트워크를 사용하여 Chromecast 및 기타 Google Cast 기기를 찾습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo gebruikt het lokale netwerk om Chromecast en andere Google Cast-apparaten te vinden, zodat je zenders op je tv kunt kijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo używa sieci lokalnej do wyszukiwania Chromecasta i innych urządzeń Google Cast, aby umożliwić oglądanie kanałów na telewizorze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fluxo usa a rede local para encontrar o Chromecast e outros dispositivos Google Cast, para que você possa assistir aos canais na sua TV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo использует локальную сеть, чтобы находить Chromecast и другие устройства Google Cast, — так вы сможете смотреть каналы на телевизоре."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo, kanalları TV'nizde izleyebilmeniz için Chromecast'i ve diğer Google Cast aygıtlarını bulmak amacıyla yerel ağı kullanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo 使用本地网络查找 Chromecast 及其他 Google Cast 设备，以便你在电视上观看频道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo 會使用區域網路尋找 Chromecast 及其他 Google Cast 裝置，讓你可以在電視上觀看頻道。"
          }
        }
      }
    }
  },
  "version" : "1.1"
}