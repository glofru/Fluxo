    "Everything runs on this device. What you watch and search is never sent anywhere." : {
      "comment" : "Text — Apple Intelligence features.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل شيء يعمل على هذا الجهاز. لا يتم إرسال ما تشاهده أو تبحث عنه إلى أي مكان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles läuft auf diesem Gerät. Was du ansiehst und suchst, wird nirgendwohin gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se ejecuta en este dispositivo. Lo que ves y buscas nunca se envía a ningún sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout se fait sur cet appareil. Ce que vous regardez et recherchez n’est jamais envoyé ailleurs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सब कुछ इसी डिवाइस पर चलता है। आप जो देखते और खोजते हैं, वह कहीं नहीं भेजा जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semuanya berjalan di perangkat ini. Apa yang Anda tonton dan cari tidak pernah dikirim ke mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto avviene su questo dispositivo. Ciò che guardi e cerchi non viene mai inviato altrove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての処理はこのデバイス上で行われます。視聴や検索の内容が外部に送信されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 작업은 이 기기에서 실행됩니다. 시청하거나 검색한 내용은 어디에도 전송되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles gebeurt op dit apparaat. Wat je kijkt en zoekt, wordt nooit ergens naartoe gestuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko działa na tym urządzeniu. To, co oglądasz i wyszukujesz, nigdy nie jest nigdzie wysyłane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo é processado neste dispositivo. O que você assiste e busca nunca é enviado a lugar nenhum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все работает на этом устройстве. То, что вы смотрите и ищете, никуда не отправляется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her şey bu aygıtta çalışır. İzledikleriniz ve aradıklarınız hiçbir yere gönderilmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有处理均在此设备上进行。你观看和搜索的内容绝不会被发送到任何地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有處理皆在此裝置上進行。你觀看和搜尋的內容絕不會傳送到任何地方。"
          }
        }
      }
    },
