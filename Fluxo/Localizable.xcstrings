    "Fluxo is free and open-source software, released under the MIT License. You can read, build and change its code." : {
      "comment" : "Settings › Acknowledgements: the first line, about the app's own license.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo برنامج حر ومفتوح المصدر، صادر بموجب ترخيص MIT. يمكنك قراءة شيفرته وبنائها وتعديلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo ist freie Open-Source-Software, veröffentlicht unter der MIT-Lizenz. Du kannst den Code lesen, kompilieren und ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo es software libre y de código abierto, publicado con la licencia MIT. Puedes leer, compilar y modificar su código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo est un logiciel libre et open source, distribué sous licence MIT. Vous pouvez lire, compiler et modifier son code."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo मुक्त और ओपन-सोर्स सॉफ़्टवेयर है, जिसे MIT लाइसेंस के तहत जारी किया गया है। आप इसका कोड पढ़ सकते हैं, बिल्ड कर सकते हैं और बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo adalah perangkat lunak bebas dan open source yang dirilis berdasarkan Lisensi MIT. Anda dapat membaca, mengompilasi, dan mengubah kodenya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo è software libero e open source, distribuito con licenza MIT. Puoi leggerne, compilarne e modificarne il codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxoは、MITライセンスの下で公開されている、フリーかつオープンソースのソフトウェアです。コードを読んだり、ビルドしたり、変更したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo는 MIT 라이선스에 따라 배포되는 자유 오픈 소스 소프트웨어입니다. 코드를 읽고, 빌드하고, 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo is vrije en opensourcesoftware, uitgebracht onder de MIT-licentie. Je kunt de code lezen, bouwen en wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo to wolne i otwarte oprogramowanie udostępniane na licencji MIT. Możesz czytać, kompilować i zmieniać jego kod."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fluxo é um software livre e de código aberto, distribuído sob a Licença MIT. Você pode ler, compilar e modificar o código dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo — свободное программное обеспечение с открытым исходным кодом, выпущенное под лицензией MIT. Вы можете читать, собирать и изменять его код."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo, MIT Lisansı ile yayımlanan özgür ve açık kaynaklı bir yazılımdır. Kodunu okuyabilir, derleyebilir ve değiştirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo 是依据 MIT 许可证发布的自由开源软件。你可以阅读、构建和修改其代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo 是依據 MIT 授權條款發布的自由開放原始碼軟體。你可以閱讀、建置和修改其程式碼。"
          }
        }
      }
    },
    "Fluxo is not recording." : {
      "comment" : "Siri and Shortcuts text (dialog or error) — Siri and Shortcuts.",
      "localizations" : {
