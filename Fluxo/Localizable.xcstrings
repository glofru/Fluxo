          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível acessar o dispositivo. Verifique se ele está na mesma rede Wi-Fi que este dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройство недоступно. Убедитесь, что оно подключено к той же сети Wi‑Fi, что и это устройство."
