    "LinkCopied.credentials" : {
      "comment" : "Second line of the Link Copied toast when the copied stream link contains the user name and password (or access token) of the IPTV account.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
