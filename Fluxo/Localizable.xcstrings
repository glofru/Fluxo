          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence non supporta ancora la lingua usata da Fluxo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple IntelligenceはFluxoで使用中の言語にまだ対応していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence가 아직 Fluxo에서 사용하는 언어를 지원하지 않습니다."
