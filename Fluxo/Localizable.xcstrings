        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널을 즐겨찾기에서 제거합니다. 즐겨찾기에 없으면 아무것도 변경되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert een zender uit je favorieten. Er verandert niets als hij geen favoriet is."
