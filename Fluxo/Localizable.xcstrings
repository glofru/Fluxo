    "Continue Watching will be emptied. Favorites are kept." : {
      "comment" : "Text — Settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم إفراغ متابعة المشاهدة. ستبقى المفضلة كما هي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Weiterschauen“ wird geleert. Favoriten bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vaciará Seguir viendo. Los favoritos se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
