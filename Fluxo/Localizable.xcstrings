            "value" : "مع دليل XMLTV، يعرض التلفزيون المباشر ما يُبث على كل قناة، الآن وللأسبوع القادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem XMLTV-Guide zeigt Live-TV, was auf jedem Sender läuft – jetzt und in der kommenden Woche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "With an XMLTV guide, Live TV shows what is on every channel, now and for the week ahead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una guía XMLTV, TV en directo muestra lo que se emite en cada canal, ahora y durante la próxima semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec un guide XMLTV, TV en direct affiche ce qui passe sur chaque chaîne, maintenant et pour la semaine à venir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XMLTV गाइड के साथ, लाइव TV दिखाता है कि हर चैनल पर अभी और अगले हफ़्ते तक क्या चल रहा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan panduan XMLTV, TV Langsung menampilkan acara di setiap saluran, sekarang dan untuk seminggu ke depan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una guida XMLTV, TV in diretta mostra cosa c’è su ogni canale, ora e per la prossima settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XMLTV番組表があれば、「ライブTV」に各チャンネルの現在から1週間先までの番組が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XMLTV 편성표가 있으면 ‘실시간 TV’에 모든 채널의 현재 및 향후 일주일간의 프로그램이 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met een XMLTV-gids toont Live-tv wat er op elke zender is, nu en voor de komende week."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z przewodnikiem XMLTV sekcja Telewizja na żywo pokazuje, co jest na każdym kanale teraz i przez najbliższy tydzień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com um guia XMLTV, TV ao Vivo mostra o que está passando em cada canal, agora e nos próximos sete dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С телегидом XMLTV в разделе «Прямой эфир» видно, что идет на каждом канале сейчас и на неделю вперед."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir XMLTV rehberiyle Canlı TV, her kanalda neyin yayında olduğunu şimdi ve önümüzdeki hafta için gösterir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有了 XMLTV 节目单，“电视直播”会显示每个频道现在及未来一周的节目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有了 XMLTV 節目表，「電視直播」會顯示每個頻道現在及未來一週的節目。"
          }
        }
      }
    },
