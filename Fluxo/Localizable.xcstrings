    "Reminders cannot alert you until you allow notifications for Fluxo." : {
      "comment" : "Text — Reminders screen.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن للتذكيرات تنبيهك حتى تسمح بإشعارات Fluxo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen können dich erst benachrichtigen, wenn du Mitteilungen für Fluxo erlaubst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios no podrán avisarte hasta que permitas las notificaciones de Fluxo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels ne peuvent pas vous alerter tant que vous n’autorisez pas les notifications pour Fluxo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब तक आप Fluxo की सूचनाओं को अनुमति नहीं देते, रिमाइंडर आपको अलर्ट नहीं कर सकते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengingat tidak dapat memberi tahu Anda hingga Anda mengizinkan pemberitahuan untuk Fluxo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I promemoria non possono avvisarti finché non consenti le notifiche per Fluxo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxoの通知を許可するまで、リマインダーは通知できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo의 알림을 허용해야 미리 알림을 받을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herinneringen kunnen je pas waarschuwen als je meldingen voor Fluxo toestaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypomnienia nie mogą Cię powiadomić, dopóki nie zezwolisz na powiadomienia z Fluxo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os lembretes só podem alertar você depois que você permitir notificações do Fluxo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напоминания не смогут оповещать вас, пока вы не разрешите уведомления для Fluxo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo bildirimlerine izin verene kadar anımsatıcılar sizi uyaramaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Fluxo 发送通知后，提醒才能通知你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 Fluxo 傳送通知後，提醒才能通知你。"
          }
        }
      }
    },
    "Reminds you shortly before a programme starts. Tap the notification to watch it." : {
      "comment" : "Shortcuts action description — Siri and Shortcuts.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يذكّرك قبل بدء البرنامج بقليل. اضغط على الإشعار لمشاهدته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnert dich kurz vor Beginn einer Sendung. Tippe auf die Mitteilung, um sie anzusehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisa poco antes de que empiece un programa. Toca la notificación para verlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous rappelle peu avant le début d’un programme. Touchez la notification pour le regarder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्यक्रम शुरू होने से कुछ समय पहले याद दिलाता है। देखने के लिए सूचना पर टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengingatkan Anda sesaat sebelum acara dimulai. Ketuk pemberitahuan untuk menontonnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avvisa poco prima che inizi un programma. Tocca la notifica per guardarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番組の開始直前にお知らせします。通知をタップすると視聴できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로그램이 시작되기 직전에 알려 줍니다. 알림을 탭하면 시청할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herinnert je kort voordat een programma begint. Tik op de melding om het te kijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypomina tuż przed rozpoczęciem programu. Stuknij powiadomienie, aby go obejrzeć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembra você pouco antes de um programa começar. Toque na notificação para assistir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напоминает незадолго до начала передачи. Коснитесь уведомления, чтобы смотреть."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir program başlamadan kısa süre önce anımsatır. İzlemek için bildirime dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在节目即将开始前提醒你。轻点通知即可观看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在節目即將開始前提醒你。點一下通知即可觀看。"
          }
        }
      }
    },
