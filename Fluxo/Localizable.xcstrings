    "Its favorites, watch history and TV guides come along." : {
      "comment" : "Note of the iCloud playlists sheet, when it lists one playlist: what is added with it.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُضاف معها المفضلة وسجل المشاهدة وأدلة التلفزيون الخاصة بها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoriten, Wiedergabeverlauf und TV-Guides der Playlist werden mit übernommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus favoritos, su historial de reproducción y sus guías de TV se añaden con ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses favoris, son historique de visionnage et ses guides TV sont ajoutés avec elle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके पसंदीदा, देखने का इतिहास और TV गाइड भी साथ आते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorit, riwayat tontonan, dan panduan TV-nya ikut ditambahkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con essa arrivano anche i preferiti, la cronologia di visione e le guide TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入り、視聴履歴、番組表も一緒に追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즐겨찾기, 시청 기록 및 TV 편성표도 함께 추가됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
