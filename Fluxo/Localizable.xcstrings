    "The device can't be reached. Check that it's on the same Wi-Fi network as this device." : {
      "comment" : "Text — Chromecast (Google Cast).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذر الوصول إلى الجهاز. تحقق من اتصاله بشبكة Wi-Fi نفسها المتصل بها هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät ist nicht erreichbar. Prüfe, ob es mit demselben WLAN verbunden ist wie dieses Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder al dispositivo. Comprueba que está en la misma red Wi‑Fi que este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre l’appareil. Vérifiez qu’il est sur le même réseau Wi‑Fi que cet appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिवाइस तक नहीं पहुँचा जा सकता। जाँचें कि वह इस डिवाइस वाले वाई-फ़ाई नेटवर्क पर ही है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat tidak dapat dijangkau. Pastikan perangkat terhubung ke jaringan Wi-Fi yang sama dengan perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo non è raggiungibile. Verifica che sia sulla stessa rete Wi‑Fi di questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスに接続できません。このデバイスと同じWi-Fiネットワークに接続されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기에 연결할 수 없습니다. 이 기기와 같은 Wi-Fi 네트워크에 연결되어 있는지 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het apparaat is niet bereikbaar. Controleer of het op hetzelfde wifinetwerk zit als dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można połączyć się z urządzeniem. Sprawdź, czy jest w tej samej sieci Wi‑Fi co to urządzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível acessar o dispositivo. Verifique se ele está na mesma rede Wi-Fi que este dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройство недоступно. Убедитесь, что оно подключено к той же сети Wi‑Fi, что и это устройство."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aygıta ulaşılamıyor. Bu aygıtla aynı Wi-Fi ağında olduğundan emin olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接设备。请检查它是否与此设备连接到同一 Wi-Fi 网络。"
