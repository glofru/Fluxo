    },
    "You're offline. Connect to the internet to watch this, or download it to watch it offline." : {
      "comment" : "Player error: the device has no network connection and this movie or episode is not downloaded.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت غير متصل بالإنترنت. اتصل بالإنترنت لمشاهدة هذا المحتوى، أو نزّله لمشاهدته دون اتصال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Stelle eine Internetverbindung her, um dies anzusehen, oder lade es, um es offline anzusehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás sin conexión. Conéctate a Internet para verlo o descárgalo para verlo sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors connexion. Connectez-vous à Internet pour regarder ce contenu, ou téléchargez-le pour le regarder hors connexion."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप ऑफ़लाइन हैं। इसे देखने के लिए इंटरनेट से कनेक्ट करें, या ऑफ़लाइन देखने के लिए इसे डाउनलोड करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sedang offline. Sambungkan ke internet untuk menonton ini, atau unduh agar dapat ditonton secara offline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei offline. Connettiti a Internet per guardarlo, o scaricalo per guardarlo offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインです。視聴するにはインターネットに接続するか、ダウンロードしてオフラインで視聴してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 상태입니다. 시청하려면 인터넷에 연결하거나, 다운로드하여 오프라인으로 시청하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent offline. Maak verbinding met internet om dit te kijken, of download het om het offline te kijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś offline. Połącz się z internetem, aby to obejrzeć, lub pobierz, aby oglądać offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está offline. Conecte-se à internet para assistir a isto ou baixe para assistir offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет подключения к интернету. Подключитесь, чтобы смотреть, или загрузите видео для просмотра офлайн."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimdışısınız. Bunu izlemek için internete bağlanın veya çevrimdışı izlemek için indirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已离线。请连接互联网以观看，或下载后离线观看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已離線。請連接網際網路以觀看，或下載後離線觀看。"
          }
        }
      }
    },
    "You're offline. This plays when your device is connected to the internet again." : {
      "comment" : "Player error: the device has no network connection; a live channel or stream cannot start.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت غير متصل بالإنترنت. سيبدأ التشغيل عندما يتصل جهازك بالإنترنت مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Die Wiedergabe startet, sobald dein Gerät wieder mit dem Internet verbunden ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás sin conexión. Se reproducirá cuando tu dispositivo vuelva a conectarse a Internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors connexion. La lecture démarrera lorsque votre appareil sera de nouveau connecté à Internet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप ऑफ़लाइन हैं। आपका डिवाइस फिर से इंटरनेट से कनेक्ट होने पर यह चलेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sedang offline. Ini akan diputar saat perangkat Anda tersambung ke internet lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei offline. La riproduzione inizierà quando il dispositivo sarà di nuovo connesso a Internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインです。デバイスがインターネットに再接続されると再生されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 상태입니다. 기기가 다시 인터넷에 연결되면 재생됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent offline. Dit wordt afgespeeld zodra je apparaat weer verbinding heeft met internet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś offline. Odtwarzanie rozpocznie się, gdy urządzenie znów połączy się z internetem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está offline. Isto será reproduzido quando seu dispositivo se conectar à internet de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет подключения к интернету. Воспроизведение начнется, когда устройство снова подключится к интернету."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimdışısınız. Aygıtınız internete yeniden bağlandığında bu oynatılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已离线。设备重新连接互联网后将开始播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已離線。裝置重新連接網際網路後將開始播放。"
          }
        }
      }
    },
