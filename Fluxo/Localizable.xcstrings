    },
    "Its programmes are removed. Reminders you set stay." : {
      "comment" : "Text — TV guide sources (Settings).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُزال برامجه. أما التذكيرات التي ضبطتها فستبقى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Sendungen werden entfernt. Deine Erinnerungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus programas se eliminan. Los recordatorios que hayas creado se mantienen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses programmes sont supprimés. Les rappels que vous avez créés sont conservés."
