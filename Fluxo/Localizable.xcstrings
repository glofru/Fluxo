    "Fluxo can't record this channel: it plays straight from its HLS playlist." : {
      "comment" : "Siri and Shortcuts error. HLS is a streaming format name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذر على Fluxo تسجيل هذه القناة: إنها تُشغَّل مباشرةً من قائمة HLS الخاصة بها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo kann diesen Sender nicht aufnehmen: Er wird direkt aus seiner HLS-Playlist abgespielt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo no puede grabar este canal: se reproduce directamente desde su lista HLS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo ne peut pas enregistrer cette chaîne : elle est lue directement depuis sa playlist HLS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo इस चैनल को रिकॉर्ड नहीं कर सकता: यह सीधे अपनी HLS प्लेलिस्ट से चलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo tidak dapat merekam saluran ini: saluran diputar langsung dari daftar putar HLS-nya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo non può registrare questo canale: viene riprodotto direttamente dalla sua playlist HLS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxoはこのチャンネルを録画できません。HLSプレイリストから直接再生されているためです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo에서 이 채널을 녹화할 수 없습니다. HLS 재생목록에서 직접 재생되는 채널입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo kan deze zender niet opnemen: hij wordt rechtstreeks vanuit de HLS-afspeellijst afgespeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo nie może nagrać tego kanału: jest odtwarzany bezpośrednio z playlisty HLS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fluxo não pode gravar este canal: ele é reproduzido diretamente da playlist HLS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo не может записать этот канал: он воспроизводится напрямую из плейлиста HLS."
          }
        },
        "tr" : {
          "stringUnit" : {
