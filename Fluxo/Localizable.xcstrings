    "Nothing is listed on %@ now. Next: %@ at %@." : {
      "comment" : "What Siri says or shows — Siri and Shortcuts. %1$ is the channel name; %2$ is a programme title; %3$ is a time of day.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد شيء مُدرج على %1$@ الآن. التالي: %2$@ في %3$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf %@ läuft gerade nichts. Danach: %@ um %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nothing is listed on %1$@ now. Next: %2$@ at %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora no hay nada en %@. A continuación: %@ a las %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’est programmé sur %@ en ce moment. Ensuite : %@ à %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ पर अभी कुछ लिस्टेड नहीं है। अगला: %3$@ बजे %2$@।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada acara yang tercantum di %1$@ sekarang. Berikutnya: %2$@ pukul %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento su %@ non c’è nulla in programma. A seguire: %@ alle %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在%1$@で放送中の番組はありません。次は%3$@から%2$@です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 %1$@에서 방송 중인 프로그램이 없습니다. 다음 프로그램: %3$@ %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er staat nu niets op %@. Hierna: %@ om %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na kanale %@ nic teraz nie ma w programie. Następnie: %@ o %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há nada na programação de %@ agora. A seguir: %@ às %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На канале %@ сейчас ничего нет в программе. Далее: %@ в %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kanalında şu an listelenen bir şey yok. Sonraki: %2$@, saat %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@目前没有节目。接下来：%3$@ 播出%2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@目前沒有節目。接下來：%3$@ 播出%2$@。"
          }
        }
      }
    },
