    "TV.favorites.emptyMessage" : {
      "comment" : "Apple TV Favorites page: how to add a favorite (long press on the Siri Remote).",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مع الاستمرار على قناة أو فيلم أو مسلسل، ثم اختر «إضافة إلى المفضلة»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte einen Sender, einen Film oder eine Serie gedrückt und wähle dann „Zu Favoriten hinzufügen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press and hold a channel, movie or series, then choose Add to Favorites."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado un canal, una película o una serie y elige Añadir a Favoritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement sur une chaîne, un film ou une série, puis choisissez Ajouter aux favoris."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी चैनल, फ़िल्म या सीरीज़ को दबाकर रखें, फिर “पसंदीदा में जोड़ें” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan dan tahan saluran, film, atau serial, lalu pilih Tambahkan ke Favorit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto su un canale, un film o una serie, poi scegli Aggiungi ai preferiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネル、映画、シリーズを長押しして、「お気に入りに追加」を選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널, 영화 또는 시리즈를 길게 누른 다음 ‘즐겨찾기에 추가’를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd een zender, film of serie ingedrukt en kies ‘Voeg toe aan favorieten’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnij i przytrzymaj kanał, film lub serial, a następnie wybierz Dodaj do ulubionych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionado um canal, filme ou série e escolha Adicionar aos Favoritos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте канал, фильм или сериал, затем выберите «Добавить в избранное»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kanalı, filmi veya diziyi basılı tutun, ardından Favorilere Ekle'yi seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住频道、电影或剧集，然后选择“添加到个人收藏”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住頻道、電影或影集，然後選擇「加入喜好項目」。"
          }
        }
      }
    },
