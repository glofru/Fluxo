    "TV.siri.favorite.phrase" : {
      "comment" : "Apple TV, Settings › Siri: a Siri phrase; translate it as the Add to Favorites phrase people say to Siri in this language, keeping “Fluxo”.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«أضف هذه القناة إلى مفضلتي في Fluxo»"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Füge diesen Sender zu meinen Favoriten in Fluxo hinzu“"
