    "Turn on Apple Intelligence in the Settings app to get personal suggestions, smart search and summaries." : {
      "comment" : "Text — Apple Intelligence features.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل Apple Intelligence في تطبيق الإعدادات للحصول على اقتراحات شخصية وبحث ذكي وملخصات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
