        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatrzymano nagrywanie: %@. Nagranie jest w sekcji Nagrania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação de %@ foi interrompida. Ela está em Gravações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись канала %@ остановлена. Она в разделе «Записи»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kaydı durduruldu. Kayıtlar'da."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已停止录制“%@”。录像位于“录像”中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已停止錄製「%@」。錄影位於「錄影」中。"
          }
        }
      }
    },
