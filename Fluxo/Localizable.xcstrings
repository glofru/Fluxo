    },
    "The device can't be reached. Check that it's on the same Wi-Fi network as this device." : {
      "comment" : "Text — Chromecast (Google Cast).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذر الوصول إلى الجهاز. تحقق من اتصاله بشبكة Wi-Fi نفسها المتصل بها هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät ist nicht erreichbar. Prüfe, ob es mit demselben WLAN verbunden ist wie dieses Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder al dispositivo. Comprueba que está en la misma red Wi‑Fi que este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre l’appareil. Vérifiez qu’il est sur le même réseau Wi‑Fi que cet appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिवाइस तक नहीं पहुँचा जा सकता। जाँचें कि वह इस डिवाइस वाले वाई-फ़ाई नेटवर्क पर ही है।"
