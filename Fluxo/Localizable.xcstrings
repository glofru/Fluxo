    "Say “Stop recording in Fluxo” to stop." : {
      "comment" : "Siri and Shortcuts confirmation after a recording starts. Translate the phrase in quotes as the Stop Recording shortcut phrase of this language.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قل «أوقف التسجيل في Fluxo» لإيقافه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag „Stoppe die Aufnahme in Fluxo“, um sie zu beenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di “Deja de grabar en Fluxo” para detenerla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites « Arrête l’enregistrement dans Fluxo » pour l’arrêter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोकने के लिए “Fluxo में रिकॉर्डिंग रोकें” कहें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucapkan “Hentikan rekaman di Fluxo” untuk berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di’ “Interrompi la registrazione in Fluxo” per fermarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Fluxoで録画を停止」と話しかけると停止できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중단하려면 ‘Fluxo에서 녹화 중단’이라고 말하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg ‘Stop de opname in Fluxo’ om te stoppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz „Zatrzymaj nagrywanie we Fluxo”, aby zatrzymać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga “Pare a gravação no Fluxo” para parar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажите «Останови запись в Fluxo», чтобы остановить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durdurmak için “Fluxo'da kaydı durdur” deyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说“在 Fluxo 中停止录制”即可停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說「在 Fluxo 中停止錄製」即可停止。"
          }
        }
      }
    },
