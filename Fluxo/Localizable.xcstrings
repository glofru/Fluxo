    },
    "This stream (%@) only plays on this device, so a Chromecast can't reach it." : {
      "comment" : "Text — Chromecast (Google Cast). The placeholder is a server name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا البث (%@) يعمل على هذا الجهاز فقط، لذا يتعذر على Chromecast الوصول إليه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Stream (%@) läuft nur auf diesem Gerät, daher kann ein Chromecast ihn nicht erreichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta transmisión (%@) solo se reproduce en este dispositivo, así que un Chromecast no puede acceder a ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce flux (%@) n’est lisible que sur cet appareil, un Chromecast ne peut donc pas y accéder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह स्ट्रीम (%@) केवल इसी डिवाइस पर चलती है, इसलिए Chromecast उस तक नहीं पहुँच सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stream ini (%@) hanya dapat diputar di perangkat ini, sehingga Chromecast tidak dapat menjangkaunya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo stream (%@) si riproduce solo su questo dispositivo, quindi un Chromecast non può raggiungerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このストリーム（%@）はこのデバイスでのみ再生できるため、Chromecastからはアクセスできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 스트림(%@)은 이 기기에서만 재생되므로 Chromecast에서 접근할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze stream (%@) kan alleen op dit apparaat worden afgespeeld, dus een Chromecast kan hem niet bereiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten strumień (%@) działa tylko na tym urządzeniu, więc Chromecast nie może się z nim połączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta transmissão (%@) só é reproduzida neste dispositivo, então o Chromecast não consegue acessá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот поток (%@) воспроизводится только на этом устройстве, поэтому Chromecast не может к нему подключиться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yayın (%@) yalnızca bu aygıtta oynatılabilir, bu nedenle Chromecast ona ulaşamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此流（%@）仅能在此设备上播放，因此 Chromecast 无法访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此串流（%@）只能在此裝置上播放，因此 Chromecast 無法取用。"
          }
        }
      }
    },
    "This stream can't be saved for offline viewing right now. Try again later." : {
      "comment" : "Download error: the system could not download an HLS stream for offline playback (an AVFoundation error).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذر حفظ هذا البث للمشاهدة دون اتصال حاليًا. أعد المحاولة لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Stream kann gerade nicht für die Offlinewiedergabe gespeichert werden. Versuche es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora mismo no se puede guardar esta transmisión para verla sin conexión. Vuelve a intentarlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce flux ne peut pas être enregistré pour une lecture hors connexion pour le moment. Réessayez plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस स्ट्रीम को अभी ऑफ़लाइन देखने के लिए सहेजा नहीं जा सकता। बाद में फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stream ini tidak dapat disimpan untuk ditonton offline saat ini. Coba lagi nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento non è possibile salvare questo stream per la visione offline. Riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このストリームは現在オフライン視聴用に保存できません。後でもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 이 스트림을 오프라인 시청용으로 저장할 수 없습니다. 나중에 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze stream kan nu niet worden bewaard om offline te kijken. Probeer het later opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można teraz zapisać tego strumienia do oglądania offline. Spróbuj ponownie później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível salvar esta transmissão para assistir offline agora. Tente novamente mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас не удается сохранить этот поток для просмотра офлайн. Повторите попытку позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yayın şu anda çevrimdışı izleme için kaydedilemiyor. Daha sonra yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前无法存储此流以供离线观看。请稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前無法儲存此串流以供離線觀看。請稍後再試。"
          }
        }
      }
    },
    "This version of Fluxo needs to update your library, and there isn't enough free space on this device to do it. Free up some space, then try again." : {
      "comment" : "Library recovery screen: explanation when there is not enough free space to update the library.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج هذا الإصدار من Fluxo إلى تحديث مكتبتك، ولا توجد مساحة فارغة كافية على هذا الجهاز لذلك. أفرغ بعض المساحة، ثم أعد المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version von Fluxo muss deine Mediathek aktualisieren, aber auf diesem Gerät ist dafür nicht genug Speicherplatz frei. Gib etwas Speicherplatz frei und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión de Fluxo tiene que actualizar tu biblioteca y no hay suficiente espacio libre en este dispositivo para hacerlo. Libera algo de espacio y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version de Fluxo doit mettre à jour votre bibliothèque, mais l’espace libre sur cet appareil est insuffisant pour le faire. Libérez de l’espace, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo के इस संस्करण को आपकी लाइब्रेरी अपडेट करनी है, और इसके लिए इस डिवाइस पर पर्याप्त खाली जगह नहीं है। थोड़ी जगह खाली करें, फिर दोबारा कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versi Fluxo ini perlu memperbarui perpustakaan Anda, tetapi ruang kosong di perangkat ini tidak cukup untuk melakukannya. Kosongkan sedikit ruang, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa versione di Fluxo deve aggiornare la tua libreria, ma su questo dispositivo non c’è abbastanza spazio libero per farlo. Libera un po’ di spazio, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバージョンのFluxoではライブラリを更新する必要がありますが、このデバイスに十分な空き容量がありません。空き容量を増やしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전의 Fluxo에서 보관함을 업데이트해야 하지만, 이 기기에 여유 공간이 부족합니다. 공간을 확보한 다음 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze versie van Fluxo moet je bibliotheek bijwerken, en er is niet genoeg vrije ruimte op dit apparaat om dat te doen. Maak wat ruimte vrij en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta wersja Fluxo musi zaktualizować bibliotekę, a na tym urządzeniu brakuje na to wolnego miejsca. Zwolnij trochę miejsca i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão do Fluxo precisa atualizar sua biblioteca, e não há espaço livre suficiente neste dispositivo para isso. Libere espaço e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этой версии Fluxo нужно обновить медиатеку, но на этом устройстве для этого недостаточно свободного места. Освободите место и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo'nun bu sürümünün arşivinizi güncellemesi gerekiyor, ancak bu aygıtta bunun için yeterli boş alan yok. Biraz yer açın, ardından yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本的 Fluxo 需要更新你的资料库，但此设备上的可用空间不足。请释放一些空间，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本的 Fluxo 需要更新你的資料庫，但此裝置上的可用空間不足。請釋放一些空間，然後再試一次。"
          }
        }
      }
    },
    "This video can't be played: its video format (%@) isn't supported." : {
      "comment" : "Player error: the video is in a format the app cannot decode or convert; the placeholder is the technical name of the video codec, in English (for example AV1).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذر تشغيل هذا الفيديو: صيغة الفيديو (%@) غير مدعومة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Video kann nicht abgespielt werden: Das Videoformat (%@) wird nicht unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este vídeo no se puede reproducir: su formato de vídeo (%@) no es compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire cette vidéo : son format vidéo (%@) n’est pas pris en charge."
          }
        },
        "hi" : {
