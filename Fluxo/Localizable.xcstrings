    "TV.welcome.continuity" : {
      "comment" : "Apple TV Home, first launch: how to type a playlist address (the Siri Remote, dictation, or the Continuity Keyboard on a nearby iPhone).",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب العنوان باستخدام جهاز التحكم عن بُعد، أو بالصوت، أو بلوحة مفاتيح iPhone عندما يعرض المساعدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib die Adresse mit der Fernbedienung, per Sprache oder mit der Tastatur deines iPhone ein, wenn es dir Hilfe anbietet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Type the address with the remote, by voice, or with the keyboard of your iPhone when it offers to help."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe la dirección con el mando, con la voz o con el teclado de tu iPhone cuando te ofrezca ayuda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez l’adresse avec la télécommande, à la voix, ou avec le clavier de votre iPhone lorsqu’il vous le propose."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पता रिमोट से, आवाज़ से, या मदद की पेशकश होने पर अपने iPhone के कीबोर्ड से टाइप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik alamat dengan remote, dengan suara, atau dengan papan ketik iPhone Anda saat iPhone menawarkan bantuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita l’indirizzo con il telecomando, con la voce o con la tastiera del tuo iPhone quando ti offre aiuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスはリモコンや音声で入力できます。iPhoneに入力の案内が表示されたら、iPhoneのキーボードでも入力できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리모컨이나 음성으로 주소를 입력하거나, iPhone에 입력을 도와준다는 알림이 표시되면 iPhone 키보드로 입력하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ het adres met de afstandsbediening, met je stem of met het toetsenbord van je iPhone als die aanbiedt te helpen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz adres pilotem, głosem lub klawiaturą iPhone’a, gdy zaproponuje pomoc."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite o endereço com o controle remoto, por voz ou com o teclado do iPhone quando ele se oferecer para ajudar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите адрес с пульта, голосом или с клавиатуры iPhone, когда он предложит помощь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresi kumandayla, sesle veya iPhone'unuz yardım önerdiğinde onun klavyesiyle yazın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用遥控器或语音输入地址；iPhone 提示可以协助时，也可以用 iPhone 的键盘输入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用遙控器或語音輸入位址；iPhone 提示可協助時，也可以用 iPhone 的鍵盤輸入。"
          }
        }
      }
    },
    "Tells what a channel shows now and next. Without a channel, tells what your favorite channels show now." : {
      "comment" : "Shortcuts action description — Siri and Shortcuts.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخبرك بما تعرضه قناة الآن وما يليه. دون تحديد قناة، يخبرك بما تعرضه قنواتك المفضلة الآن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt, was auf einem Sender gerade und danach läuft. Ohne Sender sagt es, was gerade auf deinen Lieblingssendern läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica qué emite un canal ahora y a continuación. Sin un canal, indica qué emiten ahora tus canales favoritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique ce que diffuse une chaîne maintenant et ensuite. Sans chaîne, indique ce que diffusent vos chaînes favorites en ce moment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बताता है कि किसी चैनल पर अभी और आगे क्या है। चैनल न चुनने पर, बताता है कि आपके पसंदीदा चैनलों पर अभी क्या चल रहा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memberi tahu acara yang sedang dan akan tayang di saluran. Tanpa saluran, memberi tahu acara yang sedang tayang di saluran favorit Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dice cosa trasmette un canale ora e a seguire. Senza un canale, dice cosa trasmettono ora i tuoi canali preferiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネルで現在と次に放送される番組を伝えます。チャンネルを指定しない場合は、お気に入りのチャンネルで現在放送中の番組を伝えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널에서 지금 방송 중인 프로그램과 다음 프로그램을 알려 줍니다. 채널을 지정하지 않으면 즐겨찾는 채널에서 지금 방송 중인 프로그램을 알려 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertelt wat een zender nu en hierna uitzendt. Zonder zender vertelt het wat je favoriete zenders nu uitzenden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mówi, co kanał nadaje teraz i później. Bez wskazania kanału mówi, co teraz nadają Twoje ulubione kanały."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informa o que um canal está passando agora e a seguir. Sem um canal, informa o que seus canais favoritos estão passando agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщает, что идет на канале сейчас и далее. Без канала сообщает, что сейчас идет на ваших избранных каналах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kanalda şu an ve sonra ne olduğunu söyler. Kanal belirtilmezse favori kanallarınızda şu an ne olduğunu söyler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告知频道现在和接下来播出的节目。未指定频道时，告知你收藏的频道现在播出的节目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告訴你頻道現在和接下來播出的節目。未指定頻道時，告訴你喜好頻道現在播出的節目。"
          }
        }
      }
    },
