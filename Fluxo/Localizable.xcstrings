            "value" : "De favorieten, kijkgeschiedenis en tv-gidsen ervan gaan mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jej ulubione, historia oglądania i przewodniki TV zostaną dodane razem z nią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os favoritos, o histórico de reprodução e os guias de TV dela vêm junto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вместе с ним добавятся избранное, история просмотра и телегиды."
