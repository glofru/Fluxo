    "The stream's data is damaged or isn't video" : {
      "comment" : "Player or recording error, the technical reason after 'Unable to open the stream:' and similar: FFmpeg found invalid data (a web page instead of a stream, or a damaged file)."
    },
    "The video can't be converted while the app is in the background. Try again with the app open." : {
      "comment" : "Error while saving a recording or a download whose video must be converted: the system does not allow it while the app is in the background.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذر تحويل الفيديو أثناء عمل التطبيق في الخلفية. أعد المحاولة والتطبيق مفتوح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Video kann nicht konvertiert werden, während die App im Hintergrund ist. Versuche es bei geöffneter App erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vídeo no se puede convertir mientras la app está en segundo plano. Vuelve a intentarlo con la app abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vidéo ne peut pas être convertie lorsque l’app est en arrière-plan. Réessayez avec l’app ouverte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप बैकग्राउंड में होने पर वीडियो कन्वर्ट नहीं किया जा सकता। ऐप खुला रखकर फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video tidak dapat dikonversi saat app berada di latar belakang. Coba lagi dengan app terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il video non può essere convertito mentre l’app è in background. Riprova con l’app aperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appがバックグラウンドにある間はビデオを変換できません。Appを開いた状態でもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 백그라운드에 있는 동안에는 비디오를 변환할 수 없습니다. 앱을 연 상태에서 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De video kan niet worden geconverteerd terwijl de app op de achtergrond is. Probeer het opnieuw met de app geopend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można przekonwertować wideo, gdy aplikacja działa w tle. Spróbuj ponownie przy otwartej aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
