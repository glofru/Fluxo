            "state" : "translated",
            "value" : "无法与服务器建立安全连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法與伺服器建立安全連線。"
          }
        }
      }
