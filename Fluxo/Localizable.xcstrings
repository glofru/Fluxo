      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد اقتراحات في Fluxo بعد. شاهد بعض القنوات أو أضف قنوات إلى المفضلة أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo hat noch keine Vorschläge. Sieh dir zuerst ein paar Sender an oder füge Favoriten hinzu."
