    "This stream (%@) only plays on this device, so a Chromecast can't reach it." : {
      "comment" : "Text — Chromecast (Google Cast). The placeholder is a server name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا البث (%@) يعمل على هذا الجهاز فقط، لذا يتعذر على Chromecast الوصول إليه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Stream (%@) läuft nur auf diesem Gerät, daher kann ein Chromecast ihn nicht erreichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta transmisión (%@) solo se reproduce en este dispositivo, así que un Chromecast no puede acceder a ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce flux (%@) n’est lisible que sur cet appareil, un Chromecast ne peut donc pas y accéder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह स्ट्रीम (%@) केवल इसी डिवाइस पर चलती है, इसलिए Chromecast उस तक नहीं पहुँच सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stream ini (%@) hanya dapat diputar di perangkat ini, sehingga Chromecast tidak dapat menjangkaunya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo stream (%@) si riproduce solo su questo dispositivo, quindi un Chromecast non può raggiungerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このストリーム（%@）はこのデバイスでのみ再生できるため、Chromecastからはアクセスできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 스트림(%@)은 이 기기에서만 재생되므로 Chromecast에서 접근할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze stream (%@) kan alleen op dit apparaat worden afgespeeld, dus een Chromecast kan hem niet bereiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten strumień (%@) działa tylko na tym urządzeniu, więc Chromecast nie może się z nim połączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta transmissão (%@) só é reproduzida neste dispositivo, então o Chromecast não consegue acessá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот поток (%@) воспроизводится только на этом устройстве, поэтому Chromecast не может к нему подключиться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yayın (%@) yalnızca bu aygıtta oynatılabilir, bu nedenle Chromecast ona ulaşamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
