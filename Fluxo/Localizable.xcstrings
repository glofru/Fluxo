    "Also Favorites, Recently Watched, Recordings and Search." : {
      "comment" : "Settings > Siri & Shortcuts: explanation under the Open Screen phrase: the other screens Siri can open.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وأيضًا «المفضلة» و«شوهد مؤخرًا» و«التسجيلات» و«البحث»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Außerdem Favoriten, Zuletzt angesehen, Aufnahmen und Suchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También Favoritos, Visto recientemente, Grabaciones y Buscar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais aussi Favoris, Regardés récemment, Enregistrements et Rechercher."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पसंदीदा, हाल ही में देखे गए, रिकॉर्डिंग और खोज भी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juga Favorit, Baru Ditonton, Rekaman, dan Cari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche Preferiti, Visti di recente, Registrazioni e Cerca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「お気に入り」「最近の視聴」「録画」「検索」も開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즐겨찾기, 최근 시청, 녹화 및 검색도 열 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ook Favorieten, Recent bekeken, Opnamen en Zoek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Także Ulubione, Ostatnio oglądane, Nagrania i Szukaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também Favoritos, Assistidos Recentemente, Gravações e Buscar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "А также «Избранное», «Недавно просмотренные», «Записи» и «Поиск»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrıca Favoriler, Son İzlenenler, Kayıtlar ve Arama."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可以打开“个人收藏”“最近观看”“录像”和“搜索”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可以打開「喜好項目」、「最近觀看」、「錄影」和「搜尋」。"
          }
        }
      }
    },
