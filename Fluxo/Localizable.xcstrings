    "%@ will be freed on this device. You can download them again while you're online." : {
      "comment" : "Message of the confirmation to delete downloads; the placeholder is a size such as 2.1 GB.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم تحرير %@ على هذا الجهاز. يمكنك تنزيلها مرة أخرى عندما تكون متصلًا بالإنترنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät werden %@ frei. Du kannst sie wieder laden, wenn du online bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se liberarán %@ en este dispositivo. Puedes volver a descargarlas cuando tengas conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ seront libérés sur cet appareil. Vous pourrez les télécharger à nouveau lorsque vous serez en ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर %@ खाली हो जाएगा। ऑनलाइन होने पर आप इन्हें फिर से डाउनलोड कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ akan dikosongkan di perangkat ini. Anda dapat mengunduhnya lagi saat online."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno liberati %@ su questo dispositivo. Puoi scaricarli di nuovo quando sei online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスで%@の空き容量が増えます。オンラインのときにもう一度ダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 %@의 공간이 확보됩니다. 온라인 상태일 때 다시 다운로드할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er komt %@ vrij op dit apparaat. Je kunt ze opnieuw downloaden als je online bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tym urządzeniu zostanie zwolnione %@. Możesz pobrać je ponownie, gdy będziesz online."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ serão liberados neste dispositivo. Você pode baixá-los de novo quando estiver online."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом устройстве освободится %@. Их можно загрузить снова при подключении к интернету."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıtta %@ yer açılacak. Çevrimiçiyken bunları yeniden indirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将在此设备上释放 %@ 空间。联网时可以重新下载。"
          }
        },
        "zh-Hant" : {
