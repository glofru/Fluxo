    "%@ can't play this channel: it's a raw MPEG-TS stream, which Chromecast doesn't support. It keeps playing on this device." : {
      "comment" : "Text — Chromecast (Google Cast). The placeholder is device name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذر على %@ تشغيل هذه القناة: إنها بث MPEG-TS خام لا يدعمه Chromecast. يستمر تشغيلها على هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann diesen Sender nicht abspielen: Es ist ein reiner MPEG-TS-Stream, den Chromecast nicht unterstützt. Die Wiedergabe läuft auf diesem Gerät weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede reproducir este canal: es una transmisión MPEG-TS sin procesar, que Chromecast no admite. Se sigue reproduciendo en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas lire cette chaîne : il s’agit d’un flux MPEG-TS brut, que Chromecast ne prend pas en charge. La lecture continue sur cet appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ इस चैनल को नहीं चला सकता: यह एक रॉ MPEG-TS स्ट्रीम है, जिसे Chromecast सपोर्ट नहीं करता। यह इसी डिवाइस पर चलता रहेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak dapat memutar saluran ini: ini adalah stream MPEG-TS mentah yang tidak didukung Chromecast. Saluran tetap diputar di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non può riprodurre questo canale: è uno stream MPEG-TS grezzo, che Chromecast non supporta. La riproduzione continua su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はこのチャンネルを再生できません。Chromecastが対応していないMPEG-TSストリームのためです。このデバイスで再生を続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 이 채널을 재생할 수 없습니다. Chromecast가 지원하지 않는 MPEG-TS 스트림입니다. 이 기기에서 계속 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan deze zender niet afspelen: het is een onbewerkte MPEG-TS-stream, die Chromecast niet ondersteunt. Het afspelen gaat door op dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie może odtworzyć tego kanału: to surowy strumień MPEG-TS, którego Chromecast nie obsługuje. Odtwarzanie jest kontynuowane na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não consegue reproduzir este canal: é um fluxo MPEG-TS bruto, que o Chromecast não suporta. A reprodução continua neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не может воспроизвести этот канал: это необработанный поток MPEG-TS, который Chromecast не поддерживает. Воспроизведение продолжится на этом устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bu kanalı oynatamıyor: Bu, Chromecast'in desteklemediği ham bir MPEG-TS yayını. Kanal bu aygıtta oynatılmaya devam ediyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”无法播放此频道：这是 Chromecast 不支持的原始 MPEG-TS 流，将继续在此设备上播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」無法播放此頻道：這是 Chromecast 不支援的原始 MPEG-TS 串流，將繼續在此裝置上播放。"
          }
        }
      }
    },
