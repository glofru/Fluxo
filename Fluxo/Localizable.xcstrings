    "Free test streams and open movies, to see how Fluxo works." : {
      "comment" : "VoiceOver hint of the Try the Demo Playlist button.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بث تجريبي مجاني وأفلام مفتوحة الترخيص، لترى كيف يعمل Fluxo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlose Test-Streams und freie Filme, um zu sehen, wie Fluxo funktioniert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmisiones de prueba gratuitas y películas libres, para ver cómo funciona Fluxo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des flux de test gratuits et des films libres, pour découvrir comment fonctionne Fluxo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुफ़्त टेस्ट स्ट्रीम और ओपन-लाइसेंस फ़िल्में, यह देखने के लिए कि Fluxo कैसे काम करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stream uji gratis dan film berlisensi terbuka, untuk melihat cara kerja Fluxo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stream di prova gratuiti e film liberi, per vedere come funziona Fluxo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料のテストストリームとオープンライセンスの映画で、Fluxoの使い方を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 테스트 스트림과 오픈 라이선스 영화로 Fluxo의 작동 방식을 확인할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis teststreams en films met een open licentie, om te zien hoe Fluxo werkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpłatne strumienie testowe i filmy na wolnej licencji, aby zobaczyć, jak działa Fluxo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmissões de teste gratuitas e filmes de licença aberta, para ver como o Fluxo funciona."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатные тестовые потоки и фильмы под свободной лицензией, чтобы увидеть, как работает Fluxo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo'nun nasıl çalıştığını görmek için ücretsiz test yayınları ve açık lisanslı filmler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费的测试流和开放许可的电影，带你了解 Fluxo 的使用方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免費的測試串流和開放授權電影，讓你了解 Fluxo 的使用方式。"
          }
        }
      }
