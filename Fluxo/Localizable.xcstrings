    "Playing a recording stops the live channel and saves the recording in progress." : {
      "comment" : "Text — recordings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي تشغيل تسجيل إلى إيقاف القناة المباشرة وحفظ التسجيل الجاري."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Abspielen einer Aufnahme wird der Live-Sender gestoppt und die laufende Aufnahme gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al reproducir una grabación, se detiene el canal en directo y se guarda la grabación en curso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lecture d’un enregistrement arrête la chaîne en direct et sauvegarde l’enregistrement en cours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिकॉर्डिंग चलाने से लाइव चैनल रुक जाता है और जारी रिकॉर्डिंग सहेज ली जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memutar rekaman akan menghentikan saluran langsung dan menyimpan rekaman yang sedang berlangsung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprodurre una registrazione interrompe il canale in diretta e salva la registrazione in corso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録画を再生するとライブチャンネルが停止し、録画中の内容が保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹화를 재생하면 실시간 채널이 중단되고 진행 중인 녹화가 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je een opname afspeelt, stopt de livezender en wordt de lopende opname bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtworzenie nagrania zatrzymuje kanał na żywo i zapisuje trwające nagranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduzir uma gravação interrompe o canal ao vivo e salva a gravação em andamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При воспроизведении записи канал прямого эфира остановится, а текущая запись сохранится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kaydı oynatmak canlı kanalı durdurur ve süren kaydı saklar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放录像会停止直播频道，并存储正在进行的录制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放錄影會停止直播頻道，並儲存正在進行的錄製。"
          }
        }
      }
    },
