          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche Film, Serie, Libreria, Preferiti, Registrazioni e Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
