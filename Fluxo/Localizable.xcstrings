        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje kanał do ulubionych. Jeśli już tam jest, pozostaje w ulubionych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona um canal aos seus favoritos. Ele continua favorito se já for."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет канал в избранное. Если он уже там, ничего не меняется."
