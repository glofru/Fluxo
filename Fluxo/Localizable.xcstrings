    "TV.siri.reminder.detail" : {
      "comment" : "Apple TV, Settings › Siri: what the Set Reminder phrase does. On Apple TV reminders are alerts shown by the app while it is open.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسألك Siri عن البرنامج. يذكّرك Fluxo قبل بدئه بقليل، طالما كان مفتوحًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri fragt, welche Sendung. Fluxo erinnert dich kurz vor Beginn, solange die App geöffnet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Siri asks which one. Fluxo reminds you shortly before it starts, while it's open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri te pregunta qué programa. Fluxo te avisa poco antes de que empiece, mientras la app esté abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri vous demande quel programme. Fluxo vous prévient peu avant le début, tant que l’app est ouverte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri पूछता है कि कौन-सा कार्यक्रम। Fluxo खुला रहने पर उसके शुरू होने से कुछ समय पहले आपको याद दिलाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri menanyakan acara yang mana. Fluxo mengingatkan Anda sesaat sebelum acara dimulai, selama Fluxo terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri ti chiede quale programma. Fluxo ti avvisa poco prima che inizi, finché l’app è aperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siriがどの番組かを尋ねます。Fluxoが開いている間、番組の開始直前にお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri가 어떤 프로그램인지 묻습니다. Fluxo가 열려 있는 동안 프로그램이 시작되기 직전에 알려 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri vraagt welk programma. Fluxo herinnert je er kort voor het begin aan, zolang de app open is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri zapyta, o który program chodzi. Fluxo przypomni Ci tuż przed jego rozpoczęciem, o ile aplikacja będzie otwarta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Siri pergunta qual programa. O Fluxo lembra você pouco antes de começar, enquanto estiver aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri спросит, о какой передаче речь. Fluxo напомнит вам незадолго до ее начала, если приложение будет открыто."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri hangi program olduğunu sorar. Fluxo açık olduğu sürece, program başlamadan kısa süre önce size anımsatır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri 会询问是哪个节目。Fluxo 打开期间，会在节目即将开始前提醒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri 會詢問是哪個節目。Fluxo 開啟期間，會在節目即將開始前提醒你。"
          }
        }
      }
    },
    "TV.siri.reminder.phrase" : {
      "comment" : "Apple TV, Settings › Siri: a Siri phrase; translate it as one of the Set Reminder phrases of this language in AppShortcuts.xcstrings without ${program} (such as “Set a reminder in Fluxo”), so that Siri knows it, keeping “Fluxo”.",
      "extractionState" : "extracted_with_value",
