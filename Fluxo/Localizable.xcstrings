    "The guide is larger than %@. Use a smaller guide, for example one for your country only." : {
      "comment" : "TV guide import error; the placeholder is the size limit, such as 2 GB.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حجم الدليل أكبر من %@. استخدم دليلًا أصغر، مثل دليل خاص ببلدك فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Guide ist größer als %@. Verwende einen kleineren Guide, zum Beispiel nur für dein Land."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La guía ocupa más de %@. Usa una guía más pequeña, por ejemplo, una solo de tu país."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le guide dépasse %@. Utilisez un guide plus petit, par exemple celui de votre pays uniquement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गाइड %@ से बड़ी है। छोटी गाइड का उपयोग करें, जैसे केवल आपके देश की गाइड।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuran panduan lebih dari %@. Gunakan panduan yang lebih kecil, misalnya panduan untuk negara Anda saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La guida supera %@. Usa una guida più piccola, ad esempio solo per il tuo paese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番組表が%@を超えています。お住まいの国だけの番組表など、小さい番組表を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편성표가 %@보다 큽니다. 해당 국가 전용 편성표와 같이 더 작은 편성표를 사용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gids is groter dan %@. Gebruik een kleinere gids, bijvoorbeeld alleen voor je land."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewodnik jest większy niż %@. Użyj mniejszego przewodnika, na przykład tylko dla Twojego kraju."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O guia é maior que %@. Use um guia menor, por exemplo, apenas do seu país."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телегид больше %@. Используйте телегид поменьше, например только для вашей страны."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rehber %@ boyutundan büyük. Daha küçük bir rehber kullanın; örneğin yalnızca ülkenize ait olanı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
