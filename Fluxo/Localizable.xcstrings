    "Resuming %@, %@." : {
      "comment" : "Siri dialog of Continue Watching: the first placeholder is the movie or episode, the second how much is left, such as '25 min left'.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ استئناف %@، %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird fortgesetzt, %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanudando %@, %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprise de %@, %@."
          }
        },
        "hi" : {
          "stringUnit" : {
