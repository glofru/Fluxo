    "iCloud did not confirm the deletion. Check your connection and try again." : {
      "comment" : "Delete iCloud Data failed: the device is offline, iCloud is not available, or the server did not confirm that the data was deleted.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يؤكد iCloud الحذف. تحقّق من الاتصال وأعد المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud hat das Löschen nicht bestätigt. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud no ha confirmado la eliminación. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud n’a pas confirmé la suppression. Vérifiez votre connexion et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ने डिलीट होने की पुष्टि नहीं की। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud tidak mengonfirmasi penghapusan. Periksa koneksi Anda dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud non ha confermato l’eliminazione. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudから削除の確認が得られませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud에서 삭제를 확인하지 못했습니다. 연결 상태를 확인한 후 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud heeft de verwijdering niet bevestigd. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud nie potwierdził usunięcia. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iCloud não confirmou a exclusão. Verifique sua conexão e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud не подтвердил удаление. Проверьте подключение и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud silme işlemini onaylamadı. Bağlantınızı denetleyip yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 未确认删除。请检查网络连接，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 未確認刪除。請檢查網路連線，然後再試一次。"
          }
        }
      }
    },
    "iCloud is busy. Fluxo tries again shortly." : {
      "comment" : "Settings › iCloud status: iCloud is busy or asked the app to slow down; the sync is retried by itself.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud مشغول. سيحاول Fluxo مرة أخرى بعد قليل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ist ausgelastet. Fluxo versucht es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud está ocupado. Fluxo volverá a intentarlo en breve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud est occupé. Fluxo réessaiera sous peu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud व्यस्त है। Fluxo थोड़ी देर में फिर से कोशिश करेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud sedang sibuk. Fluxo akan mencoba lagi sebentar lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud è occupato. Fluxo riproverà a breve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudが混み合っています。Fluxoはまもなく再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud가 사용 중입니다. Fluxo가 잠시 후 다시 시도합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud is bezet. Fluxo probeert het zo opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługa iCloud jest zajęta. Fluxo wkrótce spróbuje ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iCloud está ocupado. O Fluxo tentará novamente em breve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud занят. Fluxo скоро повторит попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud meşgul. Fluxo kısa süre içinde yeniden deneyecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 繁忙。Fluxo 稍后会重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 忙碌中。Fluxo 稍後會再試一次。"
          }
        }
      }
    },
    "iCloud is not available right now" : {
      "comment" : "Settings › iCloud status: the account is temporarily unavailable (for example while it is being set up).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud غير متاح الآن"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ist gerade nicht verfügbar"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud no está disponible en este momento"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud n’est pas disponible pour le moment"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud अभी उपलब्ध नहीं है"
          }
        },
        "id" : {
