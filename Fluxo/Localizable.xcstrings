    "TV.player.stopRecording.message" : {
      "comment" : "Apple TV player: message of the alert when Menu is pressed while the live channel is being recorded.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إغلاق المشغّل يوقف التسجيل. ويُحفظ ما سُجّل حتى الآن في المكتبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du den Player schließt, wird die Aufnahme beendet. Was bisher aufgenommen wurde, wird in der Mediathek gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Closing the player stops the recording. What was recorded so far is saved in Library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cerrar el reproductor se detiene la grabación. Lo grabado hasta ahora se guarda en Biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermer le lecteur arrête l’enregistrement. Ce qui a déjà été enregistré est sauvegardé dans Bibliothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लेयर बंद करने से रिकॉर्डिंग रुक जाती है। अब तक जो रिकॉर्ड हुआ है, वह लाइब्रेरी में सहेजा जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menutup pemutar akan menghentikan rekaman. Bagian yang sudah direkam disimpan di Perpustakaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudendo il player, la registrazione si interrompe. Quanto registrato finora viene salvato in Libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレーヤーを閉じると録画が停止します。それまでに録画された内容は「ライブラリ」に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플레이어를 닫으면 녹화가 중단됩니다. 지금까지 녹화된 내용은 ‘보관함’에 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de speler sluit, stopt de opname. Wat tot nu toe is opgenomen, wordt bewaard in Bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknięcie odtwarzacza zatrzyma nagrywanie. To, co zostało dotąd nagrane, zostanie zapisane w sekcji Biblioteka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fechar o reprodutor interrompe a gravação. O que foi gravado até agora é salvo na Biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если закрыть плеер, запись остановится. Уже записанное будет сохранено в разделе «Медиатека»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatıcıyı kapatmak kaydı durdurur. Şu ana kadar kaydedilen kısım Arşiv'de saklanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭播放器会停止录制。已录制的内容会存储到“资料库”中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉播放器會停止錄製。已錄製的內容會儲存到「資料庫」中。"
          }
        }
      }
    },
