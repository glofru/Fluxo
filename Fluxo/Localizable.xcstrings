    "Syncs them again, to add them back on your other devices." : {
      "comment" : "VoiceOver hint of Settings › iCloud › Deleted on Other Devices.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزامنها مرة أخرى لإعادة إضافتها إلى أجهزتك الأخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiert sie erneut, damit sie wieder auf deinen anderen Geräten erscheinen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a sincronizarlas para añadirlas de nuevo a tus otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les synchronise à nouveau pour les rajouter sur vos autres appareils."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उन्हें फिर से सिंक करता है, ताकि वे आपके दूसरे डिवाइस पर वापस जुड़ जाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyinkronkannya lagi, untuk menambahkannya kembali ke perangkat Anda yang lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sincronizza di nuovo per riportarle sugli altri dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一度同期して、ほかのデバイスに再び追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 동기화하여 다른 기기에 다시 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchroniseert ze opnieuw om ze weer aan je andere apparaten toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizuje je ponownie, aby przywrócić je na Twoich innych urządzeniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza-os de novo para adicioná-los de volta aos seus outros dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизирует их снова, чтобы вернуть на другие устройства."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunları diğer aygıtlarınıza geri eklemek için yeniden eşzamanlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新同步，以便将它们重新添加到你的其他设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新同步，以便將它們重新加入你的其他裝置。"
          }
        }
      }
    },
