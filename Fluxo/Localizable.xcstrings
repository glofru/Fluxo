          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo нужен доступ к локальной сети, чтобы находить устройства Cast."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo'nun Cast aygıtlarını bulmak için Yerel Ağ erişimine ihtiyacı var."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo 需要本地网络访问权限才能查找投放设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo 需要區域網路取用權限才能尋找投放裝置。"
          }
        }
      }
    },
