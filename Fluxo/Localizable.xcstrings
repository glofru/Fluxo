    "Adds a channel to your favorites, or removes it if it is one." : {
      "comment" : "Shortcuts action description — Siri and Shortcuts.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف قناة إلى المفضلة، أو يزيلها منها إن كانت مضافة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt einen Sender zu deinen Favoriten hinzu oder entfernt ihn, wenn er bereits einer ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un canal a tus favoritos o lo quita si ya es uno de ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une chaîne à vos favoris, ou l’en retire si elle y figure déjà."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी चैनल को आपके पसंदीदा में जोड़ता है, या अगर वह पहले से पसंदीदा है तो उसे हटाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan saluran ke favorit Anda, atau menghapusnya jika sudah menjadi favorit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge un canale ai preferiti o lo rimuove se lo è già."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネルをお気に入りに追加します。すでにお気に入りの場合は削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널을 즐겨찾기에 추가하거나, 이미 즐겨찾기에 있으면 제거합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt een zender toe aan je favorieten, of verwijdert hem als hij er al in staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje kanał do ulubionych lub go z nich usuwa, jeśli już tam jest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona um canal aos seus favoritos ou o remove se ele já for favorito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет канал в избранное или удаляет его, если он уже там."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kanalı favorilerinize ekler; zaten favoriyse kaldırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将频道添加到个人收藏；如果已收藏，则将其移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將頻道加入喜好項目；若已是喜好項目，則將其移除。"
          }
        }
      }
    },
    "Adds a channel to your favorites. It stays a favorite if it already is one." : {
      "comment" : "Shortcuts action description — Siri and Shortcuts.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف قناة إلى المفضلة. وتبقى في المفضلة إن كانت مضافة من قبل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt einen Sender zu deinen Favoriten hinzu. Ist er bereits ein Favorit, bleibt er es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un canal a tus favoritos. Si ya es favorito, sigue siéndolo."
          }
        },
        "fr" : {
