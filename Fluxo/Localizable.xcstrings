          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che il Chromecast e questo dispositivo siano sulla stessa rete Wi‑Fi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chromecastとこのデバイスが同じWi-Fiネットワークに接続されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
