    "TV.search.noResults.message" : {
      "comment" : "Apple TV Search: what to try when nothing matches.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقّق من الإملاء، أو ابحث عن قناة أو فيلم أو مسلسل أو برنامج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe die Schreibweise oder suche nach einem Sender, einem Film, einer Serie oder einer Sendung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check the spelling, or search for a channel, a movie, a series or a programme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba la ortografía o busca un canal, una película, una serie o un programa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez l’orthographe ou recherchez une chaîne, un film, une série ou un programme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्तनी जाँचें, या कोई चैनल, फ़िल्म, सीरीज़ या कार्यक्रम खोजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa ejaan, atau cari saluran, film, serial, atau acara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla l’ortografia o cerca un canale, un film, una serie o un programma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スペルを確認するか、チャンネル、映画、シリーズ、番組を検索してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "철자를 확인하거나 채널, 영화, 시리즈 또는 프로그램을 검색하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer de spelling of zoek naar een zender, film, serie of programma."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź pisownię lub wyszukaj kanał, film, serial albo program."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique a ortografia ou busque um canal, filme, série ou programa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте написание или поищите канал, фильм, сериал или передачу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazımı denetleyin veya bir kanal, film, dizi ya da program arayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查拼写，或搜索频道、电影、剧集或节目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請檢查拼字，或搜尋頻道、電影、影集或節目。"
          }
        }
      }
