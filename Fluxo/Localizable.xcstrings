    "TV.kind.empty.message" : {
      "comment" : "Apple TV Movies, Series or Live TV page when the playlists shown have nothing of that kind.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تحتوي قوائم التشغيل المعروضة على أي منها. أضف قائمة تشغيل أخرى، أو اعرض كل قوائم التشغيل، من الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die angezeigten Playlists enthalten nichts davon. Füge in den Einstellungen eine weitere Playlist hinzu oder zeige alle Playlists an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The playlists shown have none. Add another playlist, or show every playlist, in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las listas que se muestran no tienen contenido de este tipo. Añade otra lista o muestra todas las listas en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les playlists affichées n’en contiennent pas. Ajoutez une autre playlist ou affichez toutes les playlists dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिखाई गई प्लेलिस्ट में ऐसा कुछ नहीं है। सेटिंग्ज़ में कोई दूसरी प्लेलिस्ट जोड़ें, या सभी प्लेलिस्ट दिखाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daftar putar yang ditampilkan tidak memilikinya. Tambahkan daftar putar lain, atau tampilkan semua daftar putar, di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le playlist mostrate non ne contengono. Aggiungi un’altra playlist o mostra tutte le playlist in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示中のプレイリストには該当する項目がありません。「設定」で別のプレイリストを追加するか、すべてのプレイリストを表示してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표시 중인 재생목록에 해당 항목이 없습니다. 설정에서 다른 재생목록을 추가하거나 모든 재생목록을 표시하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De getoonde afspeellijsten hebben er geen. Voeg een andere afspeellijst toe of toon alle afspeellijsten in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlane playlisty nie mają takich pozycji. Dodaj inną playlistę lub pokaż wszystkie playlisty w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As playlists exibidas não têm conteúdo deste tipo. Adicione outra playlist ou mostre todas as playlists em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В показанных плейлистах такого нет. Добавьте другой плейлист или включите показ всех плейлистов в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gösterilen çalma listelerinde bu türde içerik yok. Ayarlar'da başka bir çalma listesi ekleyin veya tüm çalma listelerini gösterin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所显示的播放列表中没有此类内容。请在“设置”中添加其他播放列表，或显示所有播放列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所顯示的播放列表中沒有此類內容。請在「設定」中加入其他播放列表，或顯示所有播放列表。"
          }
        }
      }
    },
