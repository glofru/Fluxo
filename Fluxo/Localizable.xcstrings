        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 尚不支援 Fluxo 使用的語言。"
          }
        }
      }
    },
    "Apple Intelligence is getting ready. Its features turn on once the model has downloaded." : {
      "comment" : "Text — Apple Intelligence features.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجري تجهيز Apple Intelligence. ستعمل ميزاته بعد اكتمال تنزيل النموذج."
          }
        },
        "de" : {
          "stringUnit" : {
