        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Adicione este canal aos favoritos do Fluxo”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Добавь этот канал в мое избранное в Fluxo»"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Bu kanalı Fluxo favorilerime ekle”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“将此频道添加到 Fluxo 个人收藏”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「將此頻道加入 Fluxo 喜好項目」"
