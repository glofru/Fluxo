    },
    "Stops what Fluxo is playing and closes the player. A recording in progress is saved." : {
      "comment" : "Description of the Stop Playback action in the Shortcuts app.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقف ما يشغّله Fluxo ويغلق المشغّل. ويُحفظ أي تسجيل جارٍ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppt die Wiedergabe in Fluxo und schließt den Player. Eine laufende Aufnahme wird gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detiene lo que Fluxo está reproduciendo y cierra el reproductor. Si hay una grabación en curso, se guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrête ce que Fluxo lit et ferme le lecteur. Un enregistrement en cours est sauvegardé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo में जो चल रहा है उसे रोकता है और प्लेयर बंद करता है। चल रही रिकॉर्डिंग सहेज ली जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghentikan apa yang diputar Fluxo dan menutup pemutar. Rekaman yang sedang berjalan akan disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompe ciò che Fluxo sta riproducendo e chiude il player. Una registrazione in corso viene salvata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxoで再生中のものを停止し、プレーヤーを閉じます。進行中の録画は保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo에서 재생 중인 항목을 중단하고 플레이어를 닫습니다. 진행 중인 녹화는 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopt wat Fluxo afspeelt en sluit de speler. Een lopende opname wordt bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatrzymuje to, co odtwarza Fluxo, i zamyka odtwarzacz. Trwające nagranie zostanie zapisane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para o que o Fluxo está reproduzindo e fecha o reprodutor. Uma gravação em andamento é salva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останавливает воспроизведение в Fluxo и закрывает плеер. Текущая запись сохраняется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo'nun oynattığı içeriği durdurur ve oynatıcıyı kapatır. Devam eden kayıt saklanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止 Fluxo 正在播放的内容并关闭播放器。正在进行的录制会被存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止 Fluxo 正在播放的內容並關閉播放器。正在進行的錄製會被儲存。"
          }
        }
      }
    },
