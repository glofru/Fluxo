            "value" : "%@ वहीं से चल रहा है, %@।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melanjutkan %@, %@."
          }
        },
        "it" : {
          "stringUnit" : {
