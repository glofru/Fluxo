        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネルをお気に入りに追加します。すでにお気に入りの場合はそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널을 즐겨찾기에 추가합니다. 이미 즐겨찾기에 있으면 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt een zender toe aan je favorieten. Hij blijft een favoriet als hij dat al is."
