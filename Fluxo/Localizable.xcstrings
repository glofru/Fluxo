    "Opens Fluxo's search with your words. Searches like “football tonight” also show matching programmes." : {
      "comment" : "Shortcuts action description — Siri and Shortcuts.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح البحث في Fluxo بالكلمات التي تدخلها. عمليات البحث مثل «كرة القدم الليلة» تعرض أيضًا البرامج المطابقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Suche von Fluxo mit deinen Worten. Suchen wie „Fußball heute Abend“ zeigen auch passende Sendungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la búsqueda de Fluxo con tus palabras. Las búsquedas como “fútbol esta noche” también muestran los programas que coinciden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre la recherche de Fluxo avec vos mots. Les recherches comme « foot ce soir » affichent aussi les programmes correspondants."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके शब्दों के साथ Fluxo की खोज खोलता है। “आज रात फ़ुटबॉल” जैसी खोजों में मेल खाने वाले कार्यक्रम भी दिखते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka pencarian Fluxo dengan kata-kata Anda. Pencarian seperti “sepak bola malam ini” juga menampilkan acara yang cocok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre la ricerca di Fluxo con le tue parole. Ricerche come “calcio stasera” mostrano anche i programmi corrispondenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力した語句でFluxoの検索を開きます。「今夜のサッカー」のような検索では、一致する番組も表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력한 단어로 Fluxo 검색을 엽니다. ‘오늘 밤 축구’와 같이 검색하면 일치하는 프로그램도 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent de zoekfunctie van Fluxo met je woorden. Zoekopdrachten als ‘voetbal vanavond’ tonen ook bijpassende programma's."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwiera wyszukiwanie Fluxo z podanymi słowami. Zapytania takie jak „piłka nożna dziś wieczorem” pokazują też pasujące programy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre a busca do Fluxo com suas palavras. Buscas como “futebol hoje à noite” também mostram programas correspondentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает поиск Fluxo с вашим запросом. Запросы вроде «футбол сегодня вечером» также показывают подходящие передачи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo aramasını sözcüklerinizle açar. “bu akşam futbol” gibi aramalar eşleşen programları da gösterir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用你输入的字词打开 Fluxo 搜索。搜索“今晚的足球”之类的内容时，还会显示匹配的节目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以你輸入的字詞打開 Fluxo 搜尋。搜尋「今晚的足球」之類的內容時，也會顯示符合的節目。"
          }
        }
      }
    },
    "Opens the TV guide schedule of a channel: today and the next days, where you can set reminders." : {},
    "Opens the TV guide, search, favorites, recently watched or recordings." : {
      "comment" : "Shortcuts action description — Siri and Shortcuts.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح دليل التلفزيون أو البحث أو المفضلة أو ما شوهد مؤخرًا أو التسجيلات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet den TV-Guide, die Suche, die Favoriten, den Verlauf oder die Aufnahmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la guía de TV, la búsqueda, los favoritos, lo visto recientemente o las grabaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre le guide TV, la recherche, les favoris, les vidéos regardées récemment ou les enregistrements."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV गाइड, खोज, पसंदीदा, हाल ही में देखे गए या रिकॉर्डिंग खोलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka panduan TV, pencarian, favorit, yang baru ditonton, atau rekaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre la guida TV, la ricerca, i preferiti, i visti di recente o le registrazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番組表、検索、お気に入り、最近の視聴、録画を開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV 편성표, 검색, 즐겨찾기, 최근 시청 또는 녹화를 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent de tv-gids, zoeken, favorieten, recent bekeken of opnamen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwiera przewodnik TV, wyszukiwanie, ulubione, ostatnio oglądane lub nagrania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o guia de TV, a busca, os favoritos, os assistidos recentemente ou as gravações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает телегид, поиск, избранное, недавно просмотренное или записи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV rehberini, aramayı, favorileri, son izlenenleri veya kayıtları açar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开电视节目单、搜索、个人收藏、最近观看或录像。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開電視節目表、搜尋、喜好項目、最近觀看或錄影。"
