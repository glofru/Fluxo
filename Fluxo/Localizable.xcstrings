    "TV.programme.recordHint" : {
      "comment" : "VoiceOver hint of Record on a programme on air, on Apple TV.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل القناة ويسجّلها. ويُحفظ التسجيل في المكتبة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt den Sender ab und nimmt ihn auf. Die Aufnahme wird in der Mediathek gesichert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Plays the channel and records it. The recording is saved in Library"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce el canal y lo graba. La grabación se guarda en Biblioteca"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit la chaîne et l’enregistre. L’enregistrement est sauvegardé dans Bibliothèque"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चैनल चलाता है और उसे रिकॉर्ड करता है। रिकॉर्डिंग लाइब्रेरी में सहेजी जाती है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memutar saluran dan merekamnya. Rekaman disimpan di Perpustakaan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce il canale e lo registra. La registrazione viene salvata in Libreria"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネルを再生して録画します。録画は「ライブラリ」に保存されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널을 재생하고 녹화합니다. 녹화는 ‘보관함’에 저장됩니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt de zender af en neemt hem op. De opname wordt bewaard in Bibliotheek"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarza kanał i nagrywa go. Nagranie zostanie zapisane w sekcji Biblioteka"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz o canal e o grava. A gravação é salva na Biblioteca"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизводит канал и записывает его. Запись сохранится в разделе «Медиатека»"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanalı oynatır ve kaydeder. Kayıt Arşiv'de saklanır"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
