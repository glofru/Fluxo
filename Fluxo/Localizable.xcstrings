    "All guide sources are turned off. Turn one on to see what's on." : {
      "comment" : "Text — TV guide.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل مصادر الدليل متوقفة. شغّل أحدها لمعرفة ما يُعرض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Guide-Quellen sind deaktiviert. Aktiviere eine, um das Programm zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las fuentes de guía están desactivadas. Activa una para ver la programación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les sources de guide sont désactivées. Activez-en une pour voir les programmes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी गाइड स्रोत बंद हैं। क्या चल रहा है, यह देखने के लिए किसी एक को चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua sumber panduan dimatikan. Nyalakan salah satunya untuk melihat acara yang tayang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le fonti guida sono disattivate. Attivane una per vedere la programmazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての番組表ソースがオフになっています。放送中の番組を見るには、いずれかをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 편성표 소스가 꺼져 있습니다. 방송 중인 프로그램을 보려면 하나를 켜십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle gidsbronnen zijn uitgeschakeld. Schakel er een in om te zien wat er op tv is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie źródła przewodnika są wyłączone. Włącz jedno, aby zobaczyć, co jest w telewizji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as fontes de guia estão desativadas. Ative uma para ver a programação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все источники телегида выключены. Включите один, чтобы видеть программу передач."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm rehber kaynakları kapalı. Yayın akışını görmek için birini açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有节目单来源均已关闭。打开其中一个即可查看正在播出的节目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有節目表來源皆已關閉。開啟其中一個即可查看正在播出的節目。"
          }
        }
      }
    },
    "Allow notifications for Fluxo in Settings to get a reminder before a programme starts." : {
      "comment" : "Text — TV programme details.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بإشعارات Fluxo في الإعدادات لتلقي تذكير قبل بدء البرنامج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Mitteilungen für Fluxo in den Einstellungen, um vor Beginn einer Sendung erinnert zu werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite las notificaciones de Fluxo en Ajustes para recibir un recordatorio antes de que empiece un programa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez les notifications pour Fluxo dans Réglages pour recevoir un rappel avant le début d’un programme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्यक्रम शुरू होने से पहले रिमाइंडर पाने के लिए सेटिंग्ज़ में Fluxo की सूचनाओं को अनुमति दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan pemberitahuan untuk Fluxo di Pengaturan agar mendapatkan pengingat sebelum acara dimulai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti le notifiche per Fluxo in Impostazioni per ricevere un promemoria prima dell’inizio di un programma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番組の開始前にリマインダーを受け取るには、「設定」でFluxoの通知を許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로그램이 시작되기 전에 미리 알림을 받으려면 설정에서 Fluxo의 알림을 허용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta meldingen voor Fluxo toe in Instellingen om een herinnering te krijgen voordat een programma begint."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól na powiadomienia z Fluxo w Ustawieniach, aby otrzymać przypomnienie przed rozpoczęciem programu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita notificações do Fluxo em Ajustes para receber um lembrete antes de um programa começar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите уведомления для Fluxo в Настройках, чтобы получать напоминание перед началом передачи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir program başlamadan önce anımsatıcı almak için Ayarlar'da Fluxo bildirimlerine izin verin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中允许 Fluxo 发送通知，即可在节目开始前收到提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定」中允許 Fluxo 傳送通知，即可在節目開始前收到提醒。"
          }
        }
      }
    },
