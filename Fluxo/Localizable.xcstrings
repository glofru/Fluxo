    "Its programmes are removed. Reminders you set stay." : {
      "comment" : "Text — TV guide sources (Settings).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُزال برامجه. أما التذكيرات التي ضبطتها فستبقى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Sendungen werden entfernt. Deine Erinnerungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus programas se eliminan. Los recordatorios que hayas creado se mantienen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses programmes sont supprimés. Les rappels que vous avez créés sont conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके कार्यक्रम हटा दिए जाएँगे। आपके सेट किए गए रिमाइंडर बने रहेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acaranya akan dihapus. Pengingat yang Anda atur tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi programmi vengono rimossi. I promemoria impostati restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番組は削除されます。設定したリマインダーは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
