    "TV.siri.subtitle" : {
      "comment" : "Apple TV, Settings › Siri: how to talk to Siri with the Siri Remote.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مع الاستمرار على زر الميكروفون في Siri Remote، وقل ما تريد، ثم ارفع إصبعك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Mikrofontaste auf der Siri Remote gedrückt, sag, was du möchtest, und lass sie dann los."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold the microphone button on the Siri Remote, say what you want, then let go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el botón del micrófono del Siri Remote, di lo que quieres y suéltalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez enfoncé le bouton Micro de la Siri Remote, dites ce que vous voulez, puis relâchez-le."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri Remote पर माइक्रोफ़ोन बटन दबाकर रखें, जो चाहिए वह बोलें, फिर छोड़ दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan tombol mikrofon di Siri Remote, ucapkan yang Anda inginkan, lalu lepaskan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto il tasto del microfono sul Siri Remote, di’ cosa vuoi, poi rilascialo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri Remoteのマイクボタンを押したまま話し、話し終えたら指を放します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri Remote의 마이크 버튼을 길게 누른 채 원하는 것을 말한 다음 손을 떼십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de microfoonknop op de Siri Remote ingedrukt, zeg wat je wilt en laat dan los."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj przycisk mikrofonu na pilocie Siri Remote, powiedz, czego chcesz, a potem go puść."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionado o botão de microfone do Siri Remote, diga o que você quer e solte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
