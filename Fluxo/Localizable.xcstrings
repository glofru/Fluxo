    "This playlist is on your other devices. Add it to this Apple TV to watch it here, without typing a single address." : {
      "comment" : "Description of the iCloud playlists sheet on Apple TV, when it lists one playlist.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قائمة التشغيل هذه موجودة على أجهزتك الأخرى. أضفها إلى جهاز Apple TV هذا لمشاهدتها هنا، دون كتابة أي عنوان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Playlist ist auf deinen anderen Geräten. Füge sie diesem Apple TV hinzu, um sie hier anzusehen, ohne eine einzige Adresse einzugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta lista está en tus otros dispositivos. Añádela a este Apple TV para verla aquí sin escribir ni una sola dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette playlist se trouve sur vos autres appareils. Ajoutez-la à l’Apple TV pour la regarder ici, sans saisir la moindre adresse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह प्लेलिस्ट आपके दूसरे डिवाइस पर है। एक भी पता टाइप किए बिना इसे यहाँ देखने के लिए इस Apple TV में जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daftar putar ini ada di perangkat Anda yang lain. Tambahkan ke Apple TV ini untuk menontonnya di sini, tanpa mengetik satu alamat pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa playlist è sui tuoi altri dispositivi. Aggiungila a questa Apple TV per guardarla qui, senza digitare nemmeno un indirizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプレイリストはほかのデバイスにあります。このApple TVに追加すれば、アドレスを1文字も入力せずにここで観られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 재생목록은 다른 기기에 있습니다. 이 Apple TV에 추가하면 주소를 하나도 입력하지 않고 여기에서 시청할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze afspeellijst staat op je andere apparaten. Voeg hem toe aan deze Apple TV om hem hier te kijken, zonder ook maar één adres te typen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta playlista jest na Twoich innych urządzeniach. Dodaj ją do tego Apple TV, aby oglądać ją tutaj bez wpisywania ani jednego adresu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta playlist está nos seus outros dispositivos. Adicione-a a este Apple TV para assisti-la aqui, sem digitar nenhum endereço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот плейлист есть на ваших других устройствах. Добавьте его на этот Apple TV, чтобы смотреть здесь, не вводя ни одного адреса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu çalma listesi diğer aygıtlarınızda. Tek bir adres bile yazmadan burada izlemek için onu bu Apple TV'ye ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此播放列表位于你的其他设备上。将它添加到此 Apple TV，无需输入任何地址即可在这里观看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此播放列表位於你的其他裝置上。將它加入此 Apple TV，無須輸入任何位址即可在這裡觀看。"
          }
        }
      }
    },
