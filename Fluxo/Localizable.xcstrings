    "Stream" : {},
    "Stream files are in use while a channel plays. They are removed automatically when playback stops." : {
      "comment" : "Text — Settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكون ملفات البث قيد الاستخدام أثناء تشغيل قناة، وتُزال تلقائيًا عند إيقاف التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stream-Dateien werden verwendet, während ein Sender läuft. Sie werden automatisch entfernt, wenn die Wiedergabe endet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos de transmisión se usan mientras se reproduce un canal y se eliminan automáticamente al detener la reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers de flux sont utilisés pendant la lecture d’une chaîne. Ils sont supprimés automatiquement à l’arrêt de la lecture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चैनल चलने के दौरान स्ट्रीम फ़ाइलें उपयोग में रहती हैं। प्लेबैक रुकने पर वे अपने-आप हट जाती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File stream digunakan saat saluran diputar. File dihapus secara otomatis saat pemutaran berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file di streaming vengono usati durante la riproduzione di un canale e rimossi automaticamente quando la riproduzione si interrompe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストリームファイルはチャンネルの再生中に使用されます。再生を停止すると自動的に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스트림 파일은 채널을 재생하는 동안 사용되며, 재생이 중단되면 자동으로 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streambestanden zijn in gebruik terwijl een zender speelt. Ze worden automatisch verwijderd als het afspelen stopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki strumienia są używane podczas odtwarzania kanału. Są usuwane automatycznie po zatrzymaniu odtwarzania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arquivos de transmissão ficam em uso enquanto um canal é reproduzido. Eles são removidos automaticamente quando a reprodução para."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы потока используются, пока воспроизводится канал. Они удаляются автоматически, когда воспроизведение останавливается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kanal oynatılırken yayın dosyaları kullanılır. Oynatma durduğunda otomatik olarak kaldırılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放频道时会使用流文件。停止播放后，流文件会被自动移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放頻道時會使用串流檔案。停止播放後，串流檔案會自動移除。"
          }
        }
      }
    },
