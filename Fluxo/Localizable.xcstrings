    "M3U and M3U8 playlists over HTTP or HTTPS. Channels, groups and logos are imported on this device." : {
      "comment" : "Text — Add / Edit Playlist form.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قوائم تشغيل M3U وM3U8 عبر HTTP أو HTTPS. يتم استيراد القنوات والمجموعات والشعارات على هذا الجهاز."
          }
        },
        "de" : {
