    "Channels of the same category show here when you play one from a playlist." : {
      "comment" : "Empty-state title — player companion panel.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تشغيل قناة من قائمة تشغيل، تظهر هنا القنوات من الفئة نفسها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier erscheinen Sender derselben Kategorie, wenn du einen aus einer Playlist abspielst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen los canales de la misma categoría cuando reproduces uno de una lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chaînes de la même catégorie s’affichent ici lorsque vous en lisez une depuis une playlist."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप किसी प्लेलिस्ट से कोई चैनल चलाते हैं, तो उसी श्रेणी के चैनल यहाँ दिखते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saluran dari kategori yang sama akan muncul di sini saat Anda memutar saluran dari daftar putar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui appaiono i canali della stessa categoria quando ne riproduci uno da una playlist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイリストのチャンネルを再生すると、同じカテゴリのチャンネルがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생목록에서 채널을 재생하면 같은 카테고리의 채널이 여기에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zenders uit dezelfde categorie verschijnen hier als je er een afspeelt vanuit een afspeellijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy odtworzysz kanał z playlisty, pojawią się tu kanały z tej samej kategorii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os canais da mesma categoria aparecem aqui quando você reproduz um canal de uma playlist."
          }
