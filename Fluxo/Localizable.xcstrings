          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo potrzebuje dostępu do sieci lokalnej, aby znaleźć urządzenia Cast."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
