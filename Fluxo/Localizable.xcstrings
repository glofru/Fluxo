    "Apple Intelligence does not support the language Fluxo uses yet." : {
      "comment" : "Text — Apple Intelligence features.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يدعم Apple Intelligence اللغة التي يستخدمها Fluxo بعد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence unterstützt die Sprache, die Fluxo verwendet, noch nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence aún no es compatible con el idioma que usa Fluxo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ne prend pas encore en charge la langue utilisée par Fluxo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence अभी उस भाषा को सपोर्ट नहीं करता, जिसका उपयोग Fluxo करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
