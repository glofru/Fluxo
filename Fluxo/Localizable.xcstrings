    "TV.siri.open.detail" : {
      "comment" : "Apple TV, Settings › Siri: the other screens the Open Screen phrase opens (the names of the app's tabs and pages).",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وأيضًا الأفلام والمسلسلات والمكتبة والمفضلة والتسجيلات والإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Außerdem Filme, Serien, Mediathek, Favoriten, Aufnahmen und Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
