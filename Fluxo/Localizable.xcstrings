        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "epgshare01 देश के अनुसार मुफ़्त गाइड प्रकाशित करता है, जो हर दिन अपडेट होती हैं। इन्हें केवल उन चैनलों के लिए इस्तेमाल करें, जिन्हें देखने की आपको अनुमति है।"
