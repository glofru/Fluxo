    "TV.siri.voiceSearch.detail" : {
      "comment" : "Apple TV, Settings › Siri: what can be said to the app's Search. Translate the examples in quotes as searches people say in this language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قل اسم قناة أو فيلم أو مسلسل، أو جملة مثل «كرة القدم الليلة» أو «قنوات الأخبار الإيطالية»: يعرض Fluxo ما يطابقها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag einen Sender, einen Film oder eine Serie oder einen Satz wie „Fußball heute Abend“ oder „italienische Nachrichtensender“: Fluxo zeigt, was passt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Say a channel, a film or a series, or a sentence such as “football tonight” or “italian news channels”: Fluxo shows what matches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di un canal, una película o una serie, o una frase como “fútbol esta noche” o “canales de noticias italianos”: Fluxo muestra lo que coincide."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites une chaîne, un film ou une série, ou une phrase comme « foot ce soir » ou « chaînes d’info italiennes » : Fluxo affiche ce qui correspond."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी चैनल, फ़िल्म या सीरीज़ का नाम बोलें, या “आज रात फ़ुटबॉल” या “इटैलियन न्यूज़ चैनल” जैसा कोई वाक्य: Fluxo मेल खाने वाली चीज़ें दिखाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebutkan saluran, film, atau serial, atau kalimat seperti “sepak bola malam ini” atau “saluran berita Italia”: Fluxo menampilkan yang cocok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di’ un canale, un film o una serie, oppure una frase come “calcio stasera” o “canali di notizie italiani”: Fluxo mostra ciò che corrisponde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネル、映画、シリーズの名前や、「今夜のサッカー」「イタリアのニュースチャンネル」のような文を話すと、Fluxoが一致するものを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널, 영화 또는 시리즈 이름이나 “오늘 밤 축구”, “이탈리아 뉴스 채널”과 같은 문장을 말하면 Fluxo가 일치하는 항목을 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg een zender, een film of een serie, of een zin als ‘voetbal vanavond’ of ‘Italiaanse nieuwszenders’: Fluxo toont wat erbij past."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz nazwę kanału, filmu lub serialu albo zdanie, np. „piłka nożna dziś wieczorem” lub „włoskie kanały informacyjne”: Fluxo pokaże pasujące wyniki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga um canal, um filme ou uma série, ou uma frase como “futebol hoje à noite” ou “canais de notícias italianos”: o Fluxo mostra o que corresponde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назовите канал, фильм или сериал либо скажите фразу, например «футбол сегодня вечером» или «итальянские новостные каналы», — Fluxo покажет подходящие результаты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kanal, film veya dizi adı ya da “bu akşam futbol” veya “İtalyan haber kanalları” gibi bir cümle söyleyin: Fluxo eşleşenleri gösterir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说出频道、电影或剧集，或者“今晚的足球”“意大利新闻频道”之类的句子：Fluxo 会显示匹配的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說出頻道、電影或影集，或者「今晚的足球」、「義大利新聞頻道」之類的句子：Fluxo 會顯示符合的內容。"
          }
        }
      }
    },
