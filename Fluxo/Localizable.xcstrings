    "TV.settings.timeShift.footer" : {
      "comment" : "Apple TV Settings, Playback footer: what the time-shift buffer is.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إلى أي مدى يمكنك الرجوع عند إيقاف قناة مباشرة مؤقتًا وإرجاعها. يُطبَّق في المرة التالية التي تبدأ فيها قناة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit du einen Live-Sender pausieren und zurückspulen kannst. Gilt ab dem nächsten Start eines Senders."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How far back you can pause and rewind a live channel. Applies the next time a channel starts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta dónde puedes pausar y retroceder un canal en directo. Se aplica la próxima vez que se inicie un canal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’où vous pouvez mettre en pause et revenir en arrière sur une chaîne en direct. S’applique au prochain démarrage d’une chaîne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप किसी लाइव चैनल को कितना पीछे तक पॉज़ और रिवाइंड कर सकते हैं। अगली बार चैनल शुरू होने पर लागू होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seberapa jauh Anda dapat menjeda dan memutar mundur saluran langsung. Berlaku saat saluran berikutnya diputar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fin dove puoi mettere in pausa e riavvolgere un canale in diretta. Si applica al prossimo avvio di un canale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブチャンネルを一時停止したり巻き戻したりできる範囲です。次にチャンネルを開始したときに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 채널을 일시 정지하고 되감을 수 있는 범위입니다. 다음에 채널이 시작될 때 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe ver je een livezender kunt pauzeren en terugspoelen. Geldt vanaf de volgende keer dat een zender start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak daleko wstecz możesz wstrzymać i przewinąć kanał na żywo. Obowiązuje od następnego uruchomienia kanału."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até quanto tempo atrás você pode pausar e retroceder um canal ao vivo. Vale a partir da próxima vez que um canal começar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько далеко назад можно поставить на паузу и перемотать канал прямого эфира. Применяется при следующем запуске канала."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı bir kanalı duraklatıp ne kadar geri sarabileceğiniz. Bir kanal bir sonraki başlatıldığında uygulanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直播频道可暂停和倒回的时长。下次开始播放频道时生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直播頻道可暫停和倒轉的時間長度。下次開始播放頻道時生效。"
          }
        }
      }
    },
