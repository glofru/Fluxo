            "state" : "translated",
            "value" : "पक्का करें कि Chromecast और यह डिवाइस एक ही वाई-फ़ाई नेटवर्क पर हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
