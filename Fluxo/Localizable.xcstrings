    "Recording stopped because this device is almost full. What was recorded is saved." : {
      "comment" : "Player message: a recording was stopped because the device ran low on free space; the part already recorded is kept.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف التسجيل لأن هذا الجهاز ممتلئ تقريبًا. تم حفظ ما سُجّل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme wurde beendet, weil dieses Gerät fast voll ist. Das bisher Aufgenommene wurde gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación se ha detenido porque este dispositivo está casi lleno. Lo grabado se ha guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement s’est arrêté, car cet appareil est presque plein. Ce qui a été enregistré est conservé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिकॉर्डिंग रुक गई, क्योंकि यह डिवाइस लगभग भर गया है। जो रिकॉर्ड हुआ, वह सहेज लिया गया है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekaman berhenti karena perangkat ini hampir penuh. Hasil rekaman sudah disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione si è interrotta perché lo spazio sul dispositivo è quasi esaurito. Quanto registrato è stato salvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスの空き容量がほとんどないため、録画を停止しました。録画された内容は保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기의 저장 공간이 거의 가득 차서 녹화가 중단되었습니다. 녹화된 내용은 저장되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opname is gestopt omdat dit apparaat bijna vol is. Wat is opgenomen, is bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrywanie zatrzymano, ponieważ na tym urządzeniu prawie brakuje miejsca. Nagrany materiał został zapisany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação parou porque este dispositivo está quase cheio. O que foi gravado está salvo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись остановлена, потому что на этом устройстве почти не осталось места. Записанное сохранено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıt neredeyse dolu olduğu için kayıt durdu. Kaydedilen kısım saklandı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于此设备的存储空间即将用尽，录制已停止。已录制的内容已存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於此裝置的儲存空間即將用盡，錄製已停止。已錄製的內容已儲存。"
          }
        }
      }
    },
