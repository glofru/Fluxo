          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что Chromecast и это устройство подключены к одной сети Wi‑Fi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
