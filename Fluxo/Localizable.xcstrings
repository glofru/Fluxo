    "Stopped recording %@. It's in Recordings." : {
      "comment" : "What Siri says or shows — Siri and Shortcuts. The placeholder is a name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إيقاف تسجيل %@. ستجده في التسجيلات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahme von %@ beendet. Sie ist in „Aufnahmen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He dejado de grabar %@. Está en Grabaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai arrêté l’enregistrement de %@. Il se trouve dans Enregistrements."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ की रिकॉर्डिंग रोक दी। यह “रिकॉर्डिंग” में है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perekaman %@ dihentikan. Hasilnya ada di Rekaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho interrotto la registrazione di %@. La trovi in Registrazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の録画を停止しました。「録画」に保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 녹화를 중단했습니다. ‘녹화’에 저장되었습니다."
