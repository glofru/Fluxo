    "The app itself. Its source code is open: you can read, build and change it." : {
      "comment" : "Settings › Acknowledgements: what the Fluxo entry is (the app's own open-source code).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيق نفسه. شيفرته المصدرية مفتوحة: يمكنك قراءتها وبناؤها وتعديلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App selbst. Ihr Quellcode ist offen: Du kannst ihn lesen, kompilieren und ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La propia app. Su código fuente es abierto: puedes leerlo, compilarlo y modificarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app elle-même. Son code source est ouvert : vous pouvez le lire, le compiler et le modifier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खुद ऐप। इसका सोर्स कोड ओपन है: आप इसे पढ़ सकते हैं, बिल्ड कर सकते हैं और बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
