    "Removes a channel from your favorites. Nothing changes if it is not one." : {
      "comment" : "Description of the Remove from Favorites action in the Shortcuts app.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل قناة من المفضلة. لا يتغير شيء إن لم تكن فيها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt einen Sender aus deinen Favoriten. Ist er keiner, ändert sich nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita un canal de tus favoritos. Si no es favorito, no cambia nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire une chaîne de vos favoris. Rien ne change si elle n’en fait pas partie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी चैनल को आपके पसंदीदा से हटाता है। अगर वह पसंदीदा नहीं है, तो कुछ नहीं बदलता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus saluran dari favorit Anda. Tidak ada yang berubah jika saluran tersebut bukan favorit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove un canale dai tuoi preferiti. Se non è tra i preferiti, non cambia nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネルをお気に入りから削除します。お気に入りでない場合は何も変わりません。"
