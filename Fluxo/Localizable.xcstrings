        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके कार्यक्रम हटा दिए जाएँगे। आपके सेट किए गए रिमाइंडर बने रहेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
