{
  "sourceLanguage" : "en",
  "strings" : {
    "${action}" : {
      "comment" : "Summary of a Shortcuts action, shown in the Shortcuts editor (${…} are parameters; keep them as written) — Shortcuts app."
    },
    "${action} on ${channel}" : {
      "comment" : "Summary of a Shortcuts action, shown in the Shortcuts editor (${…} are parameters; keep them as written) — Shortcuts app."
    },
    "%@" : {
      "comment" : "Format only: shows the value as it is (a channel or programme name). Do not translate.",
      "shouldTranslate" : false
    },
