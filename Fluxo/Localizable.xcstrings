            "state" : "translated",
            "value" : "Deze video kan niet worden afgespeeld: de video-indeling (%@) wordt niet ondersteund."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można odtworzyć tego wideo: format wideo (%@) nie jest obsługiwany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível reproduzir este vídeo: o formato de vídeo (%@) não é compatível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невозможно воспроизвести это видео: видеоформат (%@) не поддерживается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu video oynatılamıyor: Video biçimi (%@) desteklenmiyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法播放此视频：不支持其视频格式（%@）。"
