            "value" : "تأكد من أن Chromecast وهذا الجهاز متصلان بشبكة Wi-Fi نفسها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle sicher, dass Chromecast und dieses Gerät mit demselben WLAN verbunden sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que el Chromecast y este dispositivo están en la misma red Wi‑Fi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous que le Chromecast et cet appareil sont sur le même réseau Wi‑Fi."
          }
        },
        "hi" : {
          "stringUnit" : {
