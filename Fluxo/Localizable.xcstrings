    "Recording…" : {
      "comment" : "A recording in the list that is still being recorded."
    },
    "Records the live channel that is playing, or plays a channel and records it, or stops the recording. Recordings are saved in Recordings." : {},
    "Records the live channel that is playing, or plays a channel and records it. Recordings are saved in Recordings." : {
      "comment" : "Shortcuts action description — Siri and Shortcuts.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجّل القناة المباشرة قيد التشغيل، أو يشغّل قناة ويسجّلها. تُحفظ التسجيلات في شاشة «التسجيلات»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimmt den laufenden Live-Sender auf oder spielt einen Sender ab und nimmt ihn auf. Aufnahmen werden in „Aufnahmen“ gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba el canal en directo que se está reproduciendo, o reproduce un canal y lo graba. Las grabaciones se guardan en Grabaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre la chaîne en direct en cours de lecture, ou lit une chaîne et l’enregistre. Les enregistrements sont sauvegardés dans Enregistrements."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चल रहे लाइव चैनल को रिकॉर्ड करता है, या कोई चैनल चलाकर उसे रिकॉर्ड करता है। रिकॉर्डिंग “रिकॉर्डिंग” में सहेजी जाती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merekam saluran langsung yang sedang diputar, atau memutar saluran lalu merekamnya. Rekaman disimpan di layar Rekaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra il canale in diretta in riproduzione, oppure riproduce un canale e lo registra. Le registrazioni vengono salvate in Registrazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生中のライブチャンネルを録画するか、チャンネルを再生して録画します。録画は「録画」に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생 중인 실시간 채널을 녹화하거나, 채널을 재생하고 녹화합니다. 녹화 항목은 ‘녹화’에 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neemt de livezender op die nu speelt, of speelt een zender af en neemt die op. Opnamen worden bewaard in Opnamen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrywa odtwarzany kanał na żywo albo odtwarza kanał i go nagrywa. Nagrania są zapisywane w Nagraniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava o canal ao vivo em reprodução, ou reproduz um canal e o grava. As gravações são salvas em Gravações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает воспроизводимый канал прямого эфира или включает канал и записывает его. Записи сохраняются в разделе «Записи»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatılan canlı kanalı kaydeder ya da bir kanalı oynatıp kaydeder. Kayıtlar, Kayıtlar bölümüne kaydedilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制正在播放的直播频道，或者播放某个频道并进行录制。录像会存储在“录像”中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄製正在播放的直播頻道，或播放某個頻道並進行錄製。錄影會儲存在「錄影」中。"
          }
        }
      }
    },
