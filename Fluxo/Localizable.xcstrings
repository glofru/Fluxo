    "TV.guide.programmeHint" : {
      "comment" : "VoiceOver hint of a programme in the Apple TV TV guide.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض البرنامج. زر التشغيل/الإيقاف المؤقت يشغّل القناة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Sendung. Die Taste „Wiedergabe/Pause“ spielt den Sender ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the programme. Play/Pause plays the channel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el programa. El botón Reproducir/Pausa reproduce el canal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le programme. Le bouton Lecture/Pause lance la chaîne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्यक्रम दिखाता है। चलाएँ/पॉज़ बटन चैनल चलाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan acara. Putar/Jeda memutar saluran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra il programma. Il tasto Riproduci/Pausa riproduce il canale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番組を表示します。再生/一時停止ボタンでチャンネルを再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로그램을 표시합니다. 재생/일시 정지 버튼을 누르면 채널이 재생됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont het programma. Met de afspeel-/pauzeknop speel je de zender af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje program. Przycisk Odtwórz/Pauza odtwarza kanał."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o programa. Reproduzir/Pausar reproduz o canal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает передачу. Кнопка «Воспроизведение/Пауза» включает канал."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programı gösterir. Oynat/Duraklat kanalı oynatır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示节目。按播放/暂停按钮可播放频道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示節目。按下播放/暫停按鈕可播放頻道。"
          }
        }
      }
