      "comment" : "Apple TV Settings, Playlists footer: how to type an address (the Continuity Keyboard of an iPhone).",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قوائم تشغيل M3U عبر HTTP أو HTTPS. عندما تظهر لوحة المفاتيح، يعرض عليك iPhone أو iPad كتابة العنوان نيابةً عنك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3U-Playlists über HTTP oder HTTPS. Wenn die Tastatur erscheint, bietet dein iPhone oder iPad an, die Adresse für dich einzugeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "M3U playlists over HTTP or HTTPS. When the keyboard shows, your iPhone or iPad offers to type the address for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listas M3U por HTTP o HTTPS. Cuando aparece el teclado, tu iPhone o iPad te ofrece escribir la dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playlists M3U en HTTP ou HTTPS. Lorsque le clavier s’affiche, votre iPhone ou iPad vous propose de saisir l’adresse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP या HTTPS पर M3U प्लेलिस्ट। कीबोर्ड दिखने पर आपका iPhone या iPad आपके लिए पता टाइप करने की पेशकश करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daftar putar M3U melalui HTTP atau HTTPS. Saat papan ketik muncul, iPhone atau iPad Anda menawarkan untuk mengetikkan alamat untuk Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playlist M3U tramite HTTP o HTTPS. Quando compare la tastiera, il tuo iPhone o iPad ti propone di digitare l’indirizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPまたはHTTPSのM3Uプレイリスト。キーボードが表示されると、iPhoneやiPadに入力用の通知が届き、そこからアドレスを入力できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP 또는 HTTPS를 통한 M3U 재생목록. 키보드가 표시되면 iPhone이나 iPad에서 주소를 대신 입력하도록 제안합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3U-afspeellijsten via HTTP of HTTPS. Als het toetsenbord verschijnt, biedt je iPhone of iPad aan om het adres voor je te typen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playlisty M3U przez HTTP lub HTTPS. Gdy pojawi się klawiatura, iPhone lub iPad zaproponuje wpisanie adresu za Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playlists M3U via HTTP ou HTTPS. Quando o teclado aparece, seu iPhone ou iPad se oferece para digitar o endereço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плейлисты M3U по HTTP или HTTPS. Когда появляется клавиатура, iPhone или iPad предлагает ввести адрес за вас."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP veya HTTPS üzerinden M3U çalma listeleri. Klavye göründüğünde iPhone'unuz veya iPad'iniz adresi sizin yerinize yazmayı önerir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 HTTP 或 HTTPS 提供的 M3U 播放列表。键盘出现时，你的 iPhone 或 iPad 会提示你用它来输入地址。"
