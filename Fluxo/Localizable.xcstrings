    "Open a programme in the guide and choose Remind Me to get a notification before it starts." : {
      "comment" : "Text — Reminders screen.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح برنامجًا في الدليل واختر «ذكّرني» لتلقي إشعار قبل بدئه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne eine Sendung im Guide und wähle „Erinnern“, um vor Beginn eine Mitteilung zu erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre un programa en la guía y elige Recordármelo para recibir una notificación antes de que empiece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez un programme dans le guide et choisissez Me le rappeler pour recevoir une notification avant son début."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गाइड में कोई कार्यक्रम खोलें और उसके शुरू होने से पहले सूचना पाने के लिए “मुझे याद दिलाएँ” चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka acara di panduan dan pilih Ingatkan Saya untuk mendapatkan pemberitahuan sebelum acara dimulai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri un programma nella guida e scegli Ricordamelo per ricevere una notifica prima che inizi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番組表で番組を開いて「リマインド」を選択すると、開始前に通知を受け取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편성표에서 프로그램을 열고 ‘미리 알림’을 선택하면 시작 전에 알림을 받을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open een programma in de gids en kies ‘Herinner me’ om een melding te krijgen voordat het begint."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz program w przewodniku i wybierz Przypomnij mi, aby otrzymać powiadomienie przed jego rozpoczęciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra um programa no guia e escolha Lembrar-me para receber uma notificação antes de ele começar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте передачу в телегиде и выберите «Напомнить», чтобы получить уведомление перед ее началом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rehberde bir programı açın ve başlamadan önce bildirim almak için Anımsat'ı seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在节目单中打开一个节目并选择“提醒我”，即可在节目开始前收到通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在節目表中打開節目並選擇「提醒我」，即可在節目開始前收到通知。"
          }
        }
      }
    },
