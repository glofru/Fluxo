    "TV.search.prompt.message" : {
      "comment" : "Apple TV Search, before anything is typed: how to search (the keyboard, or dictation with the Siri Remote).",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب باستخدام جهاز التحكم عن بُعد، أو اضغط مع الاستمرار على زر الميكروفون في Siri Remote وقل ما تبحث عنه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe mit der Fernbedienung oder halte die Mikrofontaste auf der Siri Remote gedrückt und sag, wonach du suchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Type with the remote, or hold the microphone button on the Siri Remote and say what you are looking for."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe con el mando o mantén pulsado el botón del micrófono del Siri Remote y di lo que buscas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez votre recherche avec la télécommande, ou maintenez enfoncé le bouton Micro de la Siri Remote et dites ce que vous cherchez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिमोट से टाइप करें, या Siri Remote पर माइक्रोफ़ोन बटन दबाकर रखें और बताएँ कि आप क्या ढूँढ रहे हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik dengan remote, atau tahan tombol mikrofon di Siri Remote dan sebutkan apa yang Anda cari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi con il telecomando, oppure tieni premuto il tasto del microfono sul Siri Remote e di’ cosa stai cercando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモコンで入力するか、Siri Remoteのマイクボタンを押したまま、探しているものを話してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리모컨으로 입력하거나, Siri Remote의 마이크 버튼을 길게 누른 채 찾는 항목을 말하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ met de afstandsbediening, of houd de microfoonknop op de Siri Remote ingedrukt en zeg wat je zoekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisz za pomocą pilota albo przytrzymaj przycisk mikrofonu na pilocie Siri Remote i powiedz, czego szukasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite com o controle remoto ou mantenha pressionado o botão de microfone do Siri Remote e diga o que você procura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вводите текст с пульта или удерживайте кнопку микрофона на пульте Siri Remote и скажите, что вы ищете."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumandayla yazın veya Siri Remote'taki mikrofon düğmesini basılı tutup aradığınızı söyleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用遥控器输入，或按住 Siri Remote 遥控器上的麦克风按钮并说出你要找的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用遙控器輸入，或按住 Siri Remote 遙控器上的麥克風按鈕並說出你要找的內容。"
          }
        }
      }
    },
