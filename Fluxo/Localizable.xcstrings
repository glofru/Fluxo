    "TV.siri.record.detail" : {
      "comment" : "Apple TV, Settings › Siri: what the Recording phrase does. Translate the phrase in quotes as the Stop Recording phrase of this language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القناة المباشرة التي يتم تشغيلها. قل «أوقف التسجيل في Fluxo» لحفظها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der laufende Live-Sender. Sag „Stoppe die Aufnahme in Fluxo“, um sie zu sichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The live channel that plays. Say “Stop recording in Fluxo” to save it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El canal en directo que se está reproduciendo. Di “Deja de grabar en Fluxo” para guardar la grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chaîne en direct en cours de lecture. Dites « Arrête l’enregistrement dans Fluxo » pour le sauvegarder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चल रहा लाइव चैनल। उसे सेव करने के लिए “Fluxo में रिकॉर्डिंग रोकें” कहें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saluran langsung yang sedang diputar. Ucapkan “Hentikan rekaman di Fluxo” untuk menyimpannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il canale in diretta in riproduzione. Di’ “Interrompi la registrazione in Fluxo” per salvarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生中のライブチャンネルを録画します。保存するには「Fluxoで録画を停止」と話しかけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생 중인 실시간 채널을 녹화합니다. 저장하려면 “Fluxo에서 녹화 중단”이라고 말하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De livezender die wordt afgespeeld. Zeg ‘Stop de opname in Fluxo’ om de opname te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarzany kanał na żywo. Powiedz „Zatrzymaj nagrywanie we Fluxo”, aby zapisać nagranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O canal ao vivo em reprodução. Diga “Parar a gravação no Fluxo” para salvá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Канал прямого эфира, который сейчас воспроизводится. Скажите «Останови запись в Fluxo», чтобы сохранить запись."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatılan canlı kanal. Kaydetmek için “Fluxo'da kaydı durdur” deyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制正在播放的直播频道。说“在 Fluxo 中停止录制”即可存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄製正在播放的直播頻道。說「在 Fluxo 中停止錄製」即可儲存。"
          }
        }
      }
    },
    "TV.siri.record.phrase" : {
      "comment" : "Apple TV, Settings › Siri: a Siri phrase; translate it as the Recording phrase people say to Siri in this language (“Record this in Fluxo”), keeping “Fluxo”.",
