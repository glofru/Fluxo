    "Leave empty for the channel that is playing." : {
      "comment" : "Shortcuts parameter — Siri and Shortcuts.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتركه فارغًا لاختيار القناة قيد التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer lassen für den laufenden Sender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjalo vacío para usar el canal que se está reproduciendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vide pour la chaîne en cours de lecture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चल रहे चैनल के लिए खाली छोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan kosong untuk saluran yang sedang diputar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuoto per il canale in riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空欄の場合は再生中のチャンネルが対象になります。"
