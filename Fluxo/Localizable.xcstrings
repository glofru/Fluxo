          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxo necessita dell’accesso alla rete locale per trovare i dispositivi Cast."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャストデバイスを探すには、Fluxoにローカルネットワークへのアクセスを許可する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cast 기기를 찾으려면 Fluxo에 로컬 네트워크 접근 권한이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
