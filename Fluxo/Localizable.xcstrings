        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "然後說出你要找的內容：頻道、電影、「今晚的足球」。"
          }
        }
      }
    },
    "There isn't enough free space on this device for this download." : {
      "comment" : "Download error: the device does not have enough free storage.",
      "localizations" : {
