    "Part of the %@. Its notice, as shipped with the %@, follows." : {
      "comment" : "Settings › Acknowledgements, the page of a part of the Google Cast SDK (such as Abseil): the first line. Both placeholders are the SDK's name (Google Cast SDK).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جزء من %@. ويلي ذلك إشعاره كما هو مرفق بـ %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teil des %@. Es folgt der Lizenzhinweis, wie er dem %@ beiliegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forma parte de %@. A continuación figura su aviso, tal como se distribuye con %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait partie de %@. Sa notice, telle que fournie avec %@, figure ci-dessous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ का हिस्सा। इसका नोटिस, जैसा %@ के साथ आता है, नीचे दिया गया है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagian dari %@. Pemberitahuannya, sebagaimana disertakan bersama %@, tercantum di bawah ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa parte di %@. Segue la sua nota, così come distribuita insieme a %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@の一部です。%2$@に同梱されている告知文を以下に示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 일부입니다. %2$@에 포함된 해당 고지문은 다음과 같습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderdeel van de %@. Hieronder volgt de kennisgeving ervan, zoals geleverd bij de %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Część pakietu %@. Poniżej znajduje się jej informacja w brzmieniu dołączonym do pakietu %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte do %@. Segue o aviso correspondente, tal como distribuído com o %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часть %@. Ниже приведено ее уведомление в том виде, в каком оно поставляется с %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bileşenidir. %@ ile birlikte sunulan bildirimi aşağıdadır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是 %1$@ 的一部分。以下是其随 %2$@ 提供的声明。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是 %1$@ 的一部分。以下是其隨 %2$@ 提供的聲明。"
          }
        }
      }
    },
