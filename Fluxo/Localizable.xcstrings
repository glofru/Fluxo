          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Ajoute cette chaîne à mes favoris Fluxo »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“इस चैनल को मेरे Fluxo पसंदीदा में जोड़ें”"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Tambahkan saluran ini ke favorit Fluxo saya”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Aggiungi questo canale ai miei preferiti di Fluxo”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「このチャンネルをFluxoのお気に入りに追加」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“이 채널 Fluxo 즐겨찾기에 추가해 줘”"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
