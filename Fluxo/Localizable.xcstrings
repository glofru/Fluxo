          }
        }
      }
    },
    "TV.settings.recordings.footer" : {
      "comment" : "Apple TV Settings, Recordings footer: tvOS may delete recordings when the Apple TV runs out of space.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ Apple TV بالتسجيلات في ذاكرة التخزين المؤقت: قد يحذفها tvOS عند نفاد المساحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV speichert Aufnahmen in seinem Cache: tvOS kann sie löschen, wenn der Speicherplatz knapp wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apple TV keeps recordings in its cache: tvOS may delete them when it runs out of space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Apple TV guarda las grabaciones en su caché: tvOS puede eliminarlas cuando se queda sin espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Apple TV conserve les enregistrements dans son cache : tvOS peut les supprimer en cas de manque d’espace."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV रिकॉर्डिंग को अपने कैश में रखता है: जगह खत्म होने पर tvOS उन्हें डिलीट कर सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV menyimpan rekaman di cache-nya: tvOS dapat menghapusnya saat ruang penyimpanan habis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV conserva le registrazioni nella sua cache: tvOS può eliminarle quando lo spazio si esaurisce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TVは録画をキャッシュに保存します。空き容量が不足すると、tvOSによって削除される場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV는 녹화 항목을 캐시에 보관합니다. 공간이 부족하면 tvOS가 녹화 항목을 삭제할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV bewaart opnamen in zijn cache: tvOS kan ze verwijderen als de ruimte opraakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV przechowuje nagrania w pamięci podręcznej: tvOS może je usunąć, gdy zabraknie miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Apple TV guarda as gravações no cache: o tvOS pode apagá-las quando faltar espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV хранит записи в кэше: tvOS может удалить их, когда закончится место."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV kayıtları önbelleğinde saklar: Yer kalmadığında tvOS bunları silebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV 将录像保存在缓存中：空间不足时，tvOS 可能会删除它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV 會將錄影保存在快取中：空間不足時，tvOS 可能會刪除這些錄影。"
          }
        }
      }
    },
