    "Suggestions" : {
      "comment" : "Short title of the App Shortcut that suggests channels to watch.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاقتراحات"
          }
        },
        "de" : {
