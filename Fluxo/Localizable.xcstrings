    "TV.link.unavailable.message" : {
      "comment" : "Apple TV: message of the alert when a link opens the TV guide at a channel that is no longer in the playlists; the guide opens at now instead.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تعد هذه القناة موجودة في قوائم التشغيل لديك. يعرض دليل التلفزيون ما يُعرض الآن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er ist nicht mehr in deinen Playlists. Der TV-Guide zeigt, was gerade läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It's no longer in your playlists. The TV guide shows what's on now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya no está en tus listas. La guía de TV muestra lo que se emite ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ne figure plus dans vos playlists. Le guide TV affiche ce qui passe en ce moment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह चैनल अब आपकी प्लेलिस्ट में नहीं है। TV गाइड दिखाती है कि अभी क्या चल रहा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saluran ini tidak lagi ada di daftar putar Anda. Panduan TV menampilkan acara yang sedang tayang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è più nelle tue playlist. La guida TV mostra cosa c’è in onda ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャンネルはもうプレイリストにありません。番組表には現在放送中の番組が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 채널은 더 이상 재생목록에 없습니다. TV 편성표에 지금 방송 중인 프로그램이 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze zender staat niet meer in je afspeellijsten. De tv-gids toont wat er nu op tv is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tego kanału nie ma już w Twoich playlistach. Przewodnik TV pokazuje, co jest teraz w telewizji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O canal não está mais nas suas playlists. O guia de TV mostra o que está passando agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этого канала больше нет в ваших плейлистах. Телегид показывает, что идет сейчас."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kanal artık çalma listelerinizde yok. TV rehberi şu an yayında olanları gösteriyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此频道已不在你的播放列表中。电视节目单将显示正在播出的节目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此頻道已不在你的播放列表中。電視節目表會顯示正在播出的節目。"
          }
        }
      }
    },
