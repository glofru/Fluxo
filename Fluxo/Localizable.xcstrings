          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upewnij się, że Chromecast i to urządzenie są w tej samej sieci Wi‑Fi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
