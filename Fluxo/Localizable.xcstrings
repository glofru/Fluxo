        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비워 두면 재생 중인 채널이 사용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat leeg voor de zender die nu speelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostaw puste, aby użyć odtwarzanego kanału."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe vazio para o canal em reprodução."
